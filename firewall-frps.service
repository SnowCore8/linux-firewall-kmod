[Unit]
Description=Firewall Daemon for frps Protection
After=network.target

[Service]
Type=forking
ExecStart=/usr/local/bin/firewall-daemon -c /etc/firewall/firewall-frps.conf --daemonize
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Security
NoNewPrivileges=no
ProtectSystem=false

[Install]
WantedBy=multi-user.target
