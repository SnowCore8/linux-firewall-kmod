# procfs 文本接口契约 —— /proc/firewall/ 的单一真相源
#
# 与 netlink.fwidl 的区别：netlink 是**二进制线格式**（由本文件之外的那份
# IDL 描述），procfs 是**文本协议**（写侧是命令文法，读侧是行文本）。
# 两者共用同一套生成器与同一套「生成物 vs 手写代码」的第三方校验纪律。
#
# 为什么需要这份契约
# ------------------
# 1. procfs 的写文法目前只存在于 procfs.c 的解析代码与散落各处的文档中，
#    文档与实现已经互相矛盾（见文末 defect 段）。测试（tests/conftest.py）
#    也在按自己的理解拼命令串，三方各说各话。
# 2. 读侧并非「纯人读」：`stats` 是 `key value` 行格式，测试与运维脚本
#    按行解析；`bans` 的 IP 子串被测试用来判断封禁是否生效。这部分承载
#    契约，不能随意重排。
# 3. 其余 9 个只读文件是给人看的表格，**无机器可读承诺**——契约把它们
#    显式标注为 unstable，避免下游（或未来的我）把它们当成稳定接口。
#
# 线格式/文本格式约定
# -------------------
# 1. 写侧：一次 `write(2)` 一条命令，末尾可选换行；成功返回写入字节数，
#    失败返回**负 errno**（无文本错误通道，错误信息只进内核日志）。
# 2. 写侧空白：分隔符为空格或制表符（实现用 ' ' | '\t'），不允许多余 token。
# 3. 写侧控制字符：拒绝除 '\t' 外的所有 < 0x20 字节。
# 4. 读侧：`stats` 每行 `<key> <十进制整数>\n`，key 与值以单个空格分隔。
# 5. 读侧列表顺序为**哈希遍历顺序**，无排序保证；`bans`/`whitelist`/`rates`
#    等列表文件不得依赖条目顺序。

textproto procfs

namespace Procfs

# procfs 挂载根目录
root "/proc/firewall"

# ============================================================================
# 写侧语义枚举
# ============================================================================

# bans 写入的四种语义。
#
# 历史文档宣称的 "<ip> -1" 等价解封形式已删除：旧实现的 validate_duration_string
# 只接受纯数字串，'-' 首字符直接 -EINVAL，该分支从不可达（缺陷
# PROC_DEAD_UNBAN_FORM，处置见文末 defect 段）。解封统一用 "unban <ip>"。
# 删除末尾枚举值不改变 0..3 的既有取值，线格式兼容。
enum BanOp : u8 {
  BAN_DEFAULT = 0           # "<ip>"：使用内核默认时长 fw_ban_time
  BAN_TIMED = 1             # "<ip> <seconds>"：指定时长，1..31536000
  BAN_PERMANENT = 2         # "<ip> 0"：永久（duration_secs == 0）
  UNBAN = 3                 # "unban <ip>"
}

enum WhitelistOp : u8 {
  ADD = 0                   # "add <subnet>"
  ADD_IMPLICIT = 1          # "<subnet>"：省略动词即添加（实现支持，未见于任何文档）
  REMOVE = 2                # "remove <subnet>"
}

enum ConfigParam : u8 {
  BAN_TIME = 0              # "ban_time <seconds>"：1..31536000
}

# ============================================================================
# proc 条目表：路径、权限、读侧契约强度
# ============================================================================

# 读侧契约强度取值：
#   machine    —— 行格式承载机器可读契约，重写必须保持 key 与数值类型
#   unstable   —— 人类可读表格，无稳定性承诺，允许重写时改变排版
#   none       —— 只写不读

file bans {
  mode = 0600
  access = rw
  read_format = unstable
  summary = "封禁列表；每行 '<ip> (permanent)' 或 '<ip> (expires in <N> seconds)'"
}

file whitelist {
  mode = 0600
  access = rw
  read_format = unstable
  summary = "白名单；每行 '<ip>/<prefix>  on <dev>'（分隔为两个空格）"
}

file config {
  mode = 0600
  access = rw
  read_format = unstable
  summary = "运行时配置；'ban_time: <N> seconds' 与条目计数"
}

file stats {
  mode = 0400
  access = r
  read_format = machine
  summary = "13 个计数器，每行 '<key> <value>'"
}

file rates {
  mode = 0400
  access = r
  read_format = unstable
  summary = "速率表；含配置头与 '%-40s %12llu %12llu %6lus' 明细行"
}

file udp_ports {
  mode = 0400
  access = r
  read_format = unstable
  summary = "UDP 端口分布；含 'Total entries: <n> / 512' 与明细行"
}

file icmp_types {
  mode = 0400
  access = r
  read_format = unstable
  summary = "ICMP 类型分布；含 'Total entries: <n> / 128' 与明细行"
}

file pkt_sizes {
  mode = 0400
  access = r
  read_format = unstable
  summary = "包大小分布；5 个固定区间 + 百分比"
}

file ttl_dist {
  mode = 0400
  access = r
  read_format = unstable
  summary = "TTL 分布；6 个固定区间 + 百分比"
}

file ip_frags {
  mode = 0400
  access = r
  read_format = unstable
  summary = "IP 分片统计；总包数/分片数/比例"
}

file port_scanners {
  mode = 0400
  access = r
  read_format = unstable
  summary = "端口扫描检测；阈值 5 个唯一端口，最多列 20 条"
}

file service_probes {
  mode = 0400
  access = r
  read_format = unstable
  summary = "服务探测检测；阈值 3 种协议，最多列 20 条"
}

# ============================================================================
# 写文法：每个可写文件一组「命令形式 -> 语义」
# ============================================================================

write bans {
  "<ip>" = BanOp::BAN_DEFAULT
  "<ip> <seconds>" = BanOp::BAN_TIMED
  "<ip> 0" = BanOp::BAN_PERMANENT
  "unban <ip>" = BanOp::UNBAN
}

write whitelist {
  "add <subnet>" = WhitelistOp::ADD
  "<subnet>" = WhitelistOp::ADD_IMPLICIT
  "remove <subnet>" = WhitelistOp::REMOVE
}

write config {
  "ban_time <seconds>" = ConfigParam::BAN_TIME
}

# ============================================================================
# 读侧机器可读字段（仅 read_format = machine 的文件）
# ============================================================================

# 数值类型按实现使用的 printf 转换符与底层计数器宽度确定，不得更改：
#   u32  <- "%u"  读自 atomic_t
#   u64  <- "%llu" 读自 atomic64_t
#   i32  <- "%d"  读自 atomic_t（计数类字段，业务上非负）
# 测试（tests/test_02_procfs_interface.py）逐行断言值是十进制整数，
# 运维脚本按 key 取值，故 key 名与数值可解析性均为契约。
key stats {
  "total_bans" = u32
  "total_unbans" = u32
  "whitelist_rejects" = u32
  "ban_table_full_rejects" = u32
  "alloc_failures" = u32
  "packets_dropped" = u64
  "packets_accepted" = u64
  "tcp_anomaly_dropped" = u64
  "cleanup_cycles" = u32
  "cleanup_expired_total" = u32
  "current_bans" = i32
  "current_whitelist" = i32
  "recent_additions" = u32
}

# ============================================================================
# 容量与上限
# ============================================================================

# 每个 limit 块的 entries 为条目上限；none 表示实现中无上限。
# 带 `_buckets` 前缀的事实（如哈希桶数）不是容量，不得混写为上限。
# `where` 指向该上限的**代码锚点**，由 verify_procfs.py 到源码里核对：
# 契约说的上限必须真的在代码里被实施，否则门禁失败。

limit bans {
  entries = 65535
  where = "src/kernel-module/fw_ban.c:fw_info.max_ban_entries"
  note = "条目上限由模块参数 fw_max_ban_entries 控制（默认 65535），桶锁内原子检查，到限返回 -ENOSPC 并递增 ban_table_full_rejects；4096 是哈希桶数（FW_BAN_HASH_BITS），不是容量"
}

limit whitelist {
  entries = 65535
  where = "src/kernel-module/fw_wl.c:fw_info.max_wl_entries"
  note = "条目上限由模块参数 fw_max_whitelist_entries 控制（默认 65535），插入前在桶锁内检查；旧实现「跳过容量检查（按需扩展）」已废除。daemon 侧旧 netlink/responses.rs 曾有一个 MAX_WHITELIST_ENTRIES=64 的回包长度校验常量，与本上限无关——该常量已随旧 netlink 层退役删除，白名单回包现按契约分页"
}

limit rates {
  entries = 65536
  where = "src/kernel-module/fw_main.c:fw_max_rate_entries"
  note = "受模块参数 fw_max_rate_entries 限制（默认 65536，文档化范围 1024..262144）；表满后新源地址有意放行，见 defect PROC_RATE_TABLE_FULL_FAILS_OPEN"
}

limit udp_ports {
  entries = 512
  where = "src/kernel-module/fw_types.h:MAX_UDP_PORT_ENTRIES"
  note = "显示时全量遍历，无二次截断；单次快照的展示行数另受 FW_ANALYSIS_UDP_PACK_MAX(64) 限制（与 netlink AnalysisResponse 共用同一快照）"
}

limit icmp_types {
  entries = 128
  where = "src/kernel-module/fw_types.h:MAX_ICMP_TYPE_ENTRIES"
  note = "显示时全量遍历，无二次截断；单次快照的展示行数另受 FW_ANALYSIS_ICMP_PACK_MAX(64) 限制"
}

limit port_scanners {
  entries = 20
  where = "src/kernel-module/fw_types.h:PORT_SCAN_MAX_RESULTS"
  note = "触发阈值为 5 个唯一端口（fw_types.h:PORT_SCAN_THRESHOLD）"
}

limit service_probes {
  entries = 20
  where = "src/kernel-module/fw_types.h:SERVICE_PROBE_MAX_RESULTS"
  note = "触发阈值为 3 种协议（fw_types.h:SERVICE_PROBE_THRESHOLD）"
}

# ============================================================================
# 已核实缺陷：每条都带处置结论，由 verify_procfs.py 机械核对
# ============================================================================
#
# 这些条目是**契约的一部分**，不是注释。处置结论用 status 表达，校验器据此
# 决定核对哪一侧，防止「缺陷悄悄消失，契约仍在撒谎」或「契约说修好了，代码
# 其实没动」：
#
#   status = open      未修。where 指向缺陷现场，校验器要求它**仍存在**。
#   status = fixed     已修。where 反过来必须**已消失**，fix 指向修复证据的
#                      锚点且必须存在（有证据才算修好）。
#   status = retained  有意保留。where 指向源码里「有意保留」的注释，必须存在；
#                      reason 说明为何不改。
#
# where / fix 的形状与 limit 一致：<仓库相对路径>:<锚点>。

defect PROC_DEAD_UNBAN_FORM {
  severity = high
  status = fixed
  where = "src/kernel-module/procfs.c:seconds != -1"
  fix = "src/kernel-module/fw_procfs.c:PROC_DEAD_UNBAN_FORM"
  text = "<ip> -1 解封形式不可达：validate_duration_string 要求时长首字符为数字，'-' 直接 -EINVAL，故 seconds == -1 分支为死代码。处置：删除该分支与 BanOp::UNBAN_VIA_NEGATIVE 枚举值；README 与 docs/{zh,en}/configuration/procfs.md 已同步删除该形式的宣传"
}

defect PROC_BAN_TABLE_FULL_NEVER_INC {
  severity = high
  status = fixed
  where = "src/kernel-module/procfs.c:ban_table_full_rejects"
  fix = "src/kernel-module/fw_ban.c:fw_stat_bump_ban_full"
  text = "ban_table_full_rejects 计数器无任何递增点、恒为 0，封禁表实际无容量检查。处置：新增模块参数 fw_max_ban_entries（默认 65535），在桶锁内原子检查，到限返回 -ENOSPC 并递增该计数器——这是它唯一的递增点"
}

defect PROC_WHITELIST_CAPACITY_UNENFORCED {
  severity = medium
  status = fixed
  where = "src/kernel-module/whitelist.c:跳过容量检查"
  fix = "src/kernel-module/fw_wl.c:wl_reject_count"
  text = "白名单容量检查被显式跳过，doc 宣称的 64 条上限在内核侧不存在。处置：新增模块参数 fw_max_whitelist_entries（默认 65535），插入前在桶锁内检查"
}

defect PROC_DOC_FORMAT_FICTIONAL {
  severity = medium
  status = fixed
  where = "docs/zh/configuration/procfs.md:### 封禁 IP 列表"
  fix = "src/kernel-module/fw_procfs.c:expires in %lu seconds"
  text = "文档给出的 bans/whitelist 输出为 Jail/Remaining/Protocol/Port 表格，源码中不存在该格式；真实输出为 '<ip> (permanent)' / '<ip> (expires in N seconds)' 与 '<ip>/<prefix>  on <dev>'。处置：docs/{zh,en}/configuration/procfs.md 按生成物与实现重写"
}

defect PROC_CONFIG_DOC_SAYS_READONLY {
  severity = low
  status = fixed
  where = "docs/zh/configuration/procfs.md:只读文件"
  fix = "src/kernel-module/fw_procfs.c:ban_time: %u seconds"
  text = "文档称 config 为只读（写入返回 -EINVAL），实际 config_write 支持 'ban_time <seconds>' 写入，权限 0600。处置：文档改述为可写并给出真实命令文法"
}

defect PROC_CLEANUP_CYCLES_DEAD {
  severity = low
  status = retained
  where = "src/kernel-module/fw_types.h:有意保留"
  reason = "该键自监控诞生起就在 stats 里，外部解析脚本与测试按行取值；删键会让下游静默错位。新实现已无全局清理线程（改为 per-entry 定时器），故恒为 0，但保留键位并在 fw_types.h 的字段注释里写明「恒为 0」，避免被误读成故障"
  text = "cleanup_cycles 已无全局清理线程，仅初始化时清零，恒为 0；保留字段只为不破坏外部解析"
}

defect PROC_WRITE_NO_TEXT_ERROR {
  severity = low
  status = retained
  where = "src/kernel-module/fw_procfs.c:负 errno"
  reason = "内核侧不给写失败提供文本通道是有意设计：单次 write(2) 返回负 errno 是最小的、与所有 procfs 用户共用的约定；返回文本会诱使调用方解析日志而非错误码。错误原因只进内核日志"
  text = "写失败一律返回负 errno，无文本错误通道；调用方只能从 errno 区分 -EINVAL/-EBUSY/-ENOMEM/-EPERM，无法得知具体拒绝原因"
}

defect PROC_STATS_STALE_NO_FLUSH {
  severity = medium
  status = fixed
  where = "src/kernel-module/procfs.c:stats_show"
  fix = "src/kernel-module/fw_procfs.c:fw_stats_snapshot"
  text = "stats_show 直接读 fw_info 的全局计数器，不调用跨 CPU flush；热路径把计数累加在 per-CPU 槽、达 FW_PER_CPU_BATCH_SIZE(1024) 才 flush 一次，因此只读 procfs 的监控者在低速率下会看到陈旧值（最坏每 CPU 低报 1023 个包）。处置：stats_show 改经 fw_stats_snapshot()，其内部先 fw_stats_flush_all()，与 netlink STATS_QUERY 口径一致"
}

defect PROC_WHITELIST_REMOVE_SUBNET_OVERREACH {
  severity = low
  status = fixed
  where = "src/kernel-module/procfs.c:execute_whitelist_action"
  fix = "src/kernel-module/fw_procfs.c:白名单 remove 不再自查本机 IP"
  text = "白名单 remove 判定「本机接口 IP」时用 (ip & ifa_mask) == (ifa_local & ifa_mask) 的子网比较，而自动白名单用精确主机地址 /32；接口配 /24 时该子网内任意白名单条目都判为「本机接口 IP」且拒绝删除（-EPERM）。处置：新实现不在 procfs 侧自查本机 IP，交由 fw_wl_remove() 按精确主机地址判定"
}

# ============================================================================
# 本次重写修掉的实现级缺陷（重写前不存在对应契约条目，此处补齐）
# ============================================================================

# 与上面一组同样带处置结论；status 一律 fixed，fix 指向修复证据。

defect PROC_RATE_TABLE_FULL_FAILS_OPEN {
  severity = medium
  status = fixed
  where = "src/kernel-module/rate-detector.c:无容量上限已被撤销"
  fix = "src/kernel-module/fw_rate.c:rate_slot_spill"
  text = "速率表满时旧实现静默返回 -ENOSPC、不计数也不上报，『表满』这一状态在 procfs/netlink 两侧都不可见，且『满则放行』的失败开放方向只在代码里有、契约里没有。处置：该方向保留（表满时丢包会误伤正常流量）但显式写入契约与 fw_rate.h：满则放行，并递增 fw_info.rate_slot_spill 供观测"
}

defect KERNEL_NETLINK_STRUCTS_HANDWRITTEN {
  severity = high
  status = fixed
  where = "src/kernel-module/netlink.c:struct fw_nl_ddos_event"
  fix = "src/kernel-module/fw_netlink.c:contract/generated/netlink_uapi.h"
  text = "旧实现在 netlink.c 里手抄了 16 个与契约同形的 __packed 结构体，与生成头各改各的——这是契约漂移的主要来源（DaemonRegisterAck 载荷错位即由此产生）。处置：内核侧不再声明任何报文结构，一律 #include 生成头，编译期由生成头的 _Static_assert 保证布局"
}

defect KERNEL_NO_DAEMON_REGISTER_ACK_PAYLOAD {
  severity = high
  status = fixed
  where = "src/kernel-module/netlink.c:sizeof(*resp) - 1"
  fix = "src/kernel-module/fw_netlink.c:fw_nl_send_register_ack"
  text = "旧实现把 accepted 写进 12 字节头的最后一个字节（offset 11），而契约要求它是紧随头之后的独立字节（offset 12）。daemon 侧因此完全不解析该 ack。处置：按契约写独立 accepted 字节，总长 13（生成头有 _Static_assert）"
}

defect KERNEL_LIST_RESPONSES_UNPAGED {
  severity = high
  status = fixed
  where = "src/kernel-module/netlink.c:自适应：无上限限制，返回所有条目"
  fix = "src/kernel-module/fw_netlink.c:FW_NL_BANS_PAGE_MAX"
  text = "LIST_RATES / LIST_WHITELIST 旧实现无分页无上限，一次返回全部条目（LIST_BANS 在上一提交已分页，故不在本条范围）：单条 84 字节 × 65535 条 ≈ 5.25 MB，msg_len(u16) 在 780 条以上回绕，且以 GFP_ATOMIC 做数 MB 分配。处置：三类列表响应统一按 offset/limit 分页（LIST_BANS 一并迁移到同一闸门），单页上限由 u16 上限反推"
}

defect KERNEL_RATES_PPS_HARDCODED_DIVISOR {
  severity = medium
  status = fixed
  where = "src/kernel-module/netlink.c:pkts / 2"
  fix = "src/kernel-module/fw_netlink.c:fw_nl_rates_last_jiffies"
  text = "global_pps/global_bps 旧实现硬编码除以 2，与 daemon 的 2 秒轮询周期隐式耦合——daemon 改周期即静默错值。处置：记录两次查询之间的实际 jiffies 间隔并据此折算，不再依赖任何跨模块常数"
}

defect KERNEL_STATS_FLUSH_CALLSITE_SILENT {
  severity = low
  status = fixed
  where = "src/kernel-module/netlink.c:fw_flush_all_cpu_stats"
  fix = "src/kernel-module/fw_stats.c:void fw_stats_snapshot"
  text = "跨 CPU flush 在旧实现里由 netlink.c 两处显式调用，任意新增读侧入口（如 procfs stats）都可能忘记调用而读到陈旧值——PROC_STATS_STALE_NO_FLUSH 正是这样产生的。处置：flush 收进快照函数内部（fw_stats_snapshot / fw_stats_read_analysis / fw_stats_take_traffic），调用方无法忘记"
}

# ============================================================================
# 本次新查出的稳定性问题（重写前由设计评审提出，须先写入契约再修）
# ============================================================================

defect STAB_FLOOD_GATE_PROCFS_ONLY {
  severity = medium
  status = fixed
  where = "src/kernel-module/procfs.c:check_flood_protection"
  fix = "src/kernel-module/fw_ban.c:fw_ban_flood_allow"
  text = "泛洪保护只在 procfs 路径生效：check_flood_protection() 全仓库唯一调用点是 procfs.c。netlink 指令路径与 DDoS 自决封禁路径都不检查 fw_max_bans_per_second，每条封禁都伴随 kmalloc + 定时器 + 链表插入 + netlink 事件。处置：泛洪闸门收进 fw_ban_try_add()，procfs / netlink / DDoS 三条路径统一经过同一道闸门"
}

defect STAB_LOCAL_EMPTY_TABLE_FAILS_OPEN {
  severity = medium
  status = fixed
  where = "src/kernel-module/netdev.c:local_ip_cache"
  fix = "src/kernel-module/fw_main.c:fw_netdev_rebuild_local"
  text = "本机地址集合为空时旧实现回落到「count == 0 即判定非本机」，于是本机地址会被当成外来地址参与封禁——一个失败开放的窗口。处置：fw_netdev_rebuild_local() 在注册钩子之前同步建表并发布；分配失败返回负值，调用者放弃注册钩子直接放弃加载（宁可不工作，也不带病运行）"
}

defect STAB_EXPORTED_FUNCS_UNUSED {
  severity = low
  status = fixed
  where = "src/kernel-module/firewall-main.c:EXPORT_SYMBOL"
  fix = "src/kernel-module/fw_main.c:模块内自足"
  text = "get_fw_info() / is_banned() / is_permanently_banned() 三个函数只有 EXPORT_SYMBOL、模块内无调用点，外部使用者也无从证实。处置：确认无外部使用者后删除导出，新实现不导出任何符号（模块内自足）"
}

