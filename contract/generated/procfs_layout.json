{
  "source": "procfs.fwidl",
  "kind": "textproto",
  "name": "procfs",
  "namespace": "Procfs",
  "root": "/proc/firewall",
  "notes": [
    "enum BanOp: 5 个成员，宽度 u8",
    "enum WhitelistOp: 3 个成员，宽度 u8",
    "enum ConfigParam: 1 个成员，宽度 u8",
    "file bans: mode 0600 rw read_format=unstable",
    "file whitelist: mode 0600 rw read_format=unstable",
    "file config: mode 0600 rw read_format=unstable",
    "file stats: mode 0400 r read_format=machine",
    "file rates: mode 0400 r read_format=unstable",
    "file udp_ports: mode 0400 r read_format=unstable",
    "file icmp_types: mode 0400 r read_format=unstable",
    "file pkt_sizes: mode 0400 r read_format=unstable",
    "file ttl_dist: mode 0400 r read_format=unstable",
    "file ip_frags: mode 0400 r read_format=unstable",
    "file port_scanners: mode 0400 r read_format=unstable",
    "file service_probes: mode 0400 r read_format=unstable",
    "write bans: 5 种形式",
    "write whitelist: 3 种形式",
    "write config: 1 种形式",
    "key stats: 13 个机器可读字段",
    "limit bans: 无上限（锚点 src/kernel-module/firewall.h:BAN_HASH_BITS）",
    "limit whitelist: 无上限（锚点 src/kernel-module/whitelist.c:跳过容量检查）",
    "limit rates: 65536 条（锚点 src/kernel-module/rate-detector.c:fw_max_rate_entries）",
    "limit udp_ports: 512 条（锚点 src/kernel-module/firewall.h:MAX_UDP_PORT_ENTRIES）",
    "limit icmp_types: 128 条（锚点 src/kernel-module/firewall.h:MAX_ICMP_TYPE_ENTRIES）",
    "limit port_scanners: 20 条（锚点 src/kernel-module/procfs.c:PORT_SCAN_MAX_RESULTS）",
    "limit service_probes: 20 条（锚点 src/kernel-module/procfs.c:SERVICE_PROBE_MAX_RESULTS）",
    "缺陷记录: 7 条（由 verify_*.py 到源码核对锚点）"
  ],
  "files": {
    "bans": {
      "path": "/proc/firewall/bans",
      "mode": "0600",
      "access": "rw",
      "read_format": "unstable",
      "summary": "封禁列表；每行 '<ip> (permanent)' 或 '<ip> (expires in <N> seconds)'"
    },
    "whitelist": {
      "path": "/proc/firewall/whitelist",
      "mode": "0600",
      "access": "rw",
      "read_format": "unstable",
      "summary": "白名单；每行 '<ip>/<prefix>  on <dev>'（分隔为两个空格）"
    },
    "config": {
      "path": "/proc/firewall/config",
      "mode": "0600",
      "access": "rw",
      "read_format": "unstable",
      "summary": "运行时配置；'ban_time: <N> seconds' 与条目计数"
    },
    "stats": {
      "path": "/proc/firewall/stats",
      "mode": "0400",
      "access": "r",
      "read_format": "machine",
      "summary": "13 个计数器，每行 '<key> <value>'"
    },
    "rates": {
      "path": "/proc/firewall/rates",
      "mode": "0400",
      "access": "r",
      "read_format": "unstable",
      "summary": "速率表；含配置头与 '%-40s %12llu %12llu %6lus' 明细行"
    },
    "udp_ports": {
      "path": "/proc/firewall/udp_ports",
      "mode": "0400",
      "access": "r",
      "read_format": "unstable",
      "summary": "UDP 端口分布；含 'Total entries: <n> / 512' 与明细行"
    },
    "icmp_types": {
      "path": "/proc/firewall/icmp_types",
      "mode": "0400",
      "access": "r",
      "read_format": "unstable",
      "summary": "ICMP 类型分布；含 'Total entries: <n> / 128' 与明细行"
    },
    "pkt_sizes": {
      "path": "/proc/firewall/pkt_sizes",
      "mode": "0400",
      "access": "r",
      "read_format": "unstable",
      "summary": "包大小分布；5 个固定区间 + 百分比"
    },
    "ttl_dist": {
      "path": "/proc/firewall/ttl_dist",
      "mode": "0400",
      "access": "r",
      "read_format": "unstable",
      "summary": "TTL 分布；6 个固定区间 + 百分比"
    },
    "ip_frags": {
      "path": "/proc/firewall/ip_frags",
      "mode": "0400",
      "access": "r",
      "read_format": "unstable",
      "summary": "IP 分片统计；总包数/分片数/比例"
    },
    "port_scanners": {
      "path": "/proc/firewall/port_scanners",
      "mode": "0400",
      "access": "r",
      "read_format": "unstable",
      "summary": "端口扫描检测；阈值 5 个唯一端口，最多列 20 条"
    },
    "service_probes": {
      "path": "/proc/firewall/service_probes",
      "mode": "0400",
      "access": "r",
      "read_format": "unstable",
      "summary": "服务探测检测；阈值 3 种协议，最多列 20 条"
    }
  },
  "enums": {
    "BanOp": {
      "width": "u8",
      "members": {
        "BAN_DEFAULT": 0,
        "BAN_TIMED": 1,
        "BAN_PERMANENT": 2,
        "UNBAN": 3,
        "UNBAN_VIA_NEGATIVE": 4
      }
    },
    "WhitelistOp": {
      "width": "u8",
      "members": {
        "ADD": 0,
        "ADD_IMPLICIT": 1,
        "REMOVE": 2
      }
    },
    "ConfigParam": {
      "width": "u8",
      "members": {
        "BAN_TIME": 0
      }
    }
  },
  "writes": {
    "bans": {
      "forms": [
        {
          "pattern": "<ip>",
          "op": "BanOp::BAN_DEFAULT"
        },
        {
          "pattern": "<ip> <seconds>",
          "op": "BanOp::BAN_TIMED"
        },
        {
          "pattern": "<ip> 0",
          "op": "BanOp::BAN_PERMANENT"
        },
        {
          "pattern": "unban <ip>",
          "op": "BanOp::UNBAN"
        },
        {
          "pattern": "<ip> -1",
          "op": "BanOp::UNBAN_VIA_NEGATIVE"
        }
      ]
    },
    "whitelist": {
      "forms": [
        {
          "pattern": "add <subnet>",
          "op": "WhitelistOp::ADD"
        },
        {
          "pattern": "<subnet>",
          "op": "WhitelistOp::ADD_IMPLICIT"
        },
        {
          "pattern": "remove <subnet>",
          "op": "WhitelistOp::REMOVE"
        }
      ]
    },
    "config": {
      "forms": [
        {
          "pattern": "ban_time <seconds>",
          "op": "ConfigParam::BAN_TIME"
        }
      ]
    }
  },
  "keys": {
    "stats": {
      "total_bans": "u32",
      "total_unbans": "u32",
      "whitelist_rejects": "u32",
      "ban_table_full_rejects": "u32",
      "alloc_failures": "u32",
      "packets_dropped": "u64",
      "packets_accepted": "u64",
      "tcp_anomaly_dropped": "u64",
      "cleanup_cycles": "u32",
      "cleanup_expired_total": "u32",
      "current_bans": "i32",
      "current_whitelist": "i32",
      "recent_additions": "u32"
    }
  },
  "limits": {
    "bans": {
      "entries": null,
      "note": "封禁表按需扩展，无条目上限；4096 是哈希桶数（BAN_HASH_BITS=12），不是容量",
      "where": "src/kernel-module/firewall.h:BAN_HASH_BITS"
    },
    "whitelist": {
      "entries": null,
      "note": "内核侧无上限；daemon 侧 netlink/responses.rs 以 MAX_WHITELIST_ENTRIES=64 校验回包，测试 MAX_WHITELIST_CAPACITY=64",
      "where": "src/kernel-module/whitelist.c:跳过容量检查"
    },
    "rates": {
      "entries": 65536,
      "note": "受 fw_max_rate_entries 限制，模块参数范围 1024..262144",
      "where": "src/kernel-module/rate-detector.c:fw_max_rate_entries"
    },
    "udp_ports": {
      "entries": 512,
      "note": "显示时全量遍历，无二次截断",
      "where": "src/kernel-module/firewall.h:MAX_UDP_PORT_ENTRIES"
    },
    "icmp_types": {
      "entries": 128,
      "note": "显示时全量遍历，无二次截断",
      "where": "src/kernel-module/firewall.h:MAX_ICMP_TYPE_ENTRIES"
    },
    "port_scanners": {
      "entries": 20,
      "note": "触发阈值为 5 个唯一端口（PORT_SCAN_THRESHOLD）",
      "where": "src/kernel-module/procfs.c:PORT_SCAN_MAX_RESULTS"
    },
    "service_probes": {
      "entries": 20,
      "note": "触发阈值为 3 种协议（SERVICE_PROBE_THRESHOLD）",
      "where": "src/kernel-module/procfs.c:SERVICE_PROBE_MAX_RESULTS"
    }
  },
  "defects": [
    {
      "name": "PROC_DEAD_UNBAN_FORM",
      "severity": "high",
      "where": "src/kernel-module/procfs.c:seconds != -1",
      "text": "<ip> -1 解封形式不可达：validate_duration_string 要求时长首字符为数字，'-' 直接 -EINVAL，故 seconds == -1 分支为死代码；README 与多处文档仍宣传该形式，测试也未覆盖"
    },
    {
      "name": "PROC_BAN_TABLE_FULL_NEVER_INC",
      "severity": "high",
      "where": "src/kernel-module/procfs.c:ban_table_full_rejects",
      "text": "ban_table_full_rejects 计数器只在初始化时清零、在 stats 中打印，全仓库无任何递增点，恒为 0；封禁表实际上无容量检查。文档『封禁表满（4096 条）』的说法与实现不符"
    },
    {
      "name": "PROC_WHITELIST_CAPACITY_UNENFORCED",
      "severity": "medium",
      "where": "src/kernel-module/whitelist.c:跳过容量检查",
      "text": "白名单容量检查被显式跳过（源码注释『跳过容量检查（按需扩展）』），文档宣称的 64 条上限在内核侧不存在；daemon 侧 64 是回包长度校验，不是写入上限"
    },
    {
      "name": "PROC_DOC_FORMAT_FICTIONAL",
      "severity": "medium",
      "where": "docs/zh/configuration/procfs.md:### 封禁 IP 列表",
      "text": "文档给出的 bans/whitelist 输出为 Jail/Remaining/Protocol/Port 表格，源码中不存在该格式；真实输出为 '<ip> (permanent)' / '<ip> (expires in N seconds)' 与 '<ip>/<prefix>  on <dev>'"
    },
    {
      "name": "PROC_CONFIG_DOC_SAYS_READONLY",
      "severity": "low",
      "where": "docs/zh/configuration/procfs.md:只读文件",
      "text": "文档称 config 为只读（写入返回 -EINVAL），实际 config_write 支持 'ban_time <seconds>' 写入，权限同为 0600"
    },
    {
      "name": "PROC_CLEANUP_CYCLES_DEAD",
      "severity": "low",
      "where": "src/kernel-module/procfs.c:cleanup_cycles",
      "text": "cleanup_cycles 已无全局清理线程，仅初始化时清零，恒为 0；保留字段只为不破坏外部解析"
    },
    {
      "name": "PROC_WRITE_NO_TEXT_ERROR",
      "severity": "low",
      "where": "src/kernel-module/procfs.c:return -EFAULT",
      "text": "写失败一律返回负 errno，无文本错误通道；调用方只能从 errno 区分 -EINVAL/-EBUSY/-ENOMEM/-EPERM，无法得知具体拒绝原因"
    }
  ]
}
