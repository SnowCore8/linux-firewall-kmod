# 守护进程 HTTP 接口契约 —— daemon ↔ 前端 的单一真相源
#
# 三份契约的分工：netlink.fwidl 管**字节布局**（内核↔daemon），procfs.fwidl 管
# **命令文法**（内核↔运维），本文件管**路由表 + JSON 形状 + 错误模型**
# （daemon↔前端）。
#
# 为什么需要这份契约
# ------------------
# 1. 同一个字段被写了两遍：daemon 的 Go 结构体与前端 types.ts。两边靠人工
#    同步，此前已出现 recidivism_rate 同名不同单位（百分数 0–100 vs 比例 0–1）
#    这类只在运行期才暴露的偏差。
# 2. 错误不是单一形状：信封 / 纯文本 / 框架默认三套并存，且 HTTP 状态
#    码与信封内 code 是两套编号。前端若只按一套处理，就会出现「登录错密码时
#    按钮永久转圈」这类问题（见 auth 段对 WWW-Authenticate 的说明）。
# 3. 两条 SSE 流各自有独立的连接上限（10 / 5），而诊断端点只反映其中一条，
#    前端据此判断「是否达到上限」会误判。
#
# 本文件的写法
# ------------
# - `route` 的 `auth` 描述的是**该路由对外表现出的鉴权语义**，与注册串本身
#   一起构成核对锚点：`required` 要求未带凭据时返回 401，`none` 要求带与不带
#   都放行。实现侧的包装函数名不是锚点——读写混用（GET 走 OptionalAuth）在
#   契约里就是 `required`/`none` 二选一的偏差，照报。
# - `status` 是成功路径的 HTTP 状态码。
# - `codes` 是**信封内的业务码**，不是 HTTP 状态码；声明了码就得有产出该码的
#   失败分支，否则前端永远收不到它。反过来，**没有 `codes` 的路由不得向调用方报
#   业务错误**：读不到数据时成功路径自己得成立——在 200 信封里给「空读数 + 一句
#   说明原因的 summary」，而不是 500/503。前端对这类路由因此不需要错误分支，但
#   必须能靠 summary 区分「没有数据」与「查不动」。
# - 字段名一律写**线上 JSON 的 key**（不是 Go 结构体字段名，也不是序列化 tag
#   的驼峰写法）。`type`、`method` 这类与语言关键字相撞的 key 在这里照写线上
#   拼写，实现侧用 tag 映射。
#
# 与实现核对
# ----------
# verify_http.py 会到 src/daemon/internal/http/（routes.go、auth.go、sse.go、
# logs.go、envelope.go、server.go、static.go、metrics.go）与前端
# src/api/{contract.ts,endpoints.ts,types.ts} 逐项核对：路由集合与注册串、
# 鉴权语义、SSE 上限与事件名、信封形状、业务码、错误形状、安全头，以及
# **跨层字段**（契约声明的字段必须同时是前端 interface 的成员）。契约里的
# 每条 `route` 都必须在 routes.go 里以逐字一致的 `"METHOD /path"` 注册——
# 注册串本身就是锚点，本文件不再单独维护位置索引。任何一处对不上都是门禁失败。

httpproto firewall_daemon_http

namespace Http

# API 前缀（所有 RESTful 端点都在其下）
base "/api/v1"

# ============================================================================
# 统一信封
# ============================================================================
#
# 成功：code = 0，message = ""（空串，不是 "ok"）。
# 失败：code = 业务码，data 为 null（字段必须存在，不能靠省略表达 null）。
#
# 注意：**不允许**「为空则省略」这类序列化开关。成功响应里 data 一定存在，
# 失败响应里 data 一定存在且为 null，message 一定存在。前端不需要判 undefined。

envelope {
  code: i32
  data: T
  message: String
}

# ============================================================================
# 认证
# ============================================================================
#
# Basic Auth，凭据来自配置的 metrics_username / metrics_password。
# 两项**都为空**才视为「未配置认证」并放行；半配置（只给一项）一律判失败，
# 以免一个配置笔误让整个 API 开放。
#
# 连续失败达到阈值后锁定一段时间，期间一律拒绝（含正确凭据）——这是刻意的
# 暴力破解防护，代价是运维在锁定期内无法登录。
#
# 前端登录页对应行为：凭据填错超过阈值后，正确的凭据也会被拒，直到锁定窗口
# 过去。UI 必须把这一点说清楚，否则用户会以为密码不对而反复重试、不断续锁。

auth {
  scheme = "Basic"
  token_query = "access_token"
  failure_threshold = 10
  lockout_seconds = 60
  # 401 的 HTTP 状态码（信封里没有对应业务码——认证失败走的是纯文本形状）
  unauthorized_status = 401
}

# ============================================================================
# 错误形状
# ============================================================================
#
# 三种形状并存是**实现现状**，不是设计选择。重写时应收敛为一种；在此之前
# 前端必须三种都能处理。
#
# 分派的依据是「谁写出这个状态码」，不是「它长得像哪类错误」：
#   - envelope          daemon 用统一信封写出（code 是业务码，data 是 null）
#   - text              daemon 写出的裸纯文本，只有两处：401 与静态资源 404
#   - framework_default net/http ServeMux 自产，源码里不该有构造点（404/405）
# 把 400/415/422 留在 framework_default 下是 Rust/axum 时代的遗产：那时提取器确实会
# 自产它们，而 Go 的 net/http 不会——状态码由谁产生决定了前端能不能指望它是 JSON。

errmodel AUTH_UNAUTHORIZED {
  shape = text
  statuses = 401
  body = "401 Unauthorized\n"
  note = "401 纯文本响应体（无认证失败时由鉴权中间件直接写出，不经信封）。有意不发 WWW-Authenticate：该头会让浏览器弹原生凭据对话框，且对话框期间 fetch 一直挂起拿不到响应，表现为『输错密码按钮永久转圈』。本项目用应用内登录表单，凭据由前端显式携带。严格 HTTP 语义下 401 应带该头，此处为可用性刻意偏离。"
}

errmodel STATIC_NOT_FOUND {
  shape = text
  statuses = 404
  body = "404 Not Found\n"
  note = "静态资源与 sw.js 未命中时的纯文本 404（不经信封）"
}

errmodel FRAMEWORK_DEFAULT {
  shape = framework_default
  statuses = 404, 405
  note = "框架自产错误：路径无匹配模式 404（body `404 page not found`）、模式带方法而动词不符 405（body `Method Not Allowed`）。Go 侧这两条由 net/http ServeMux 产生，daemon 源码里**不该**有它们的构造点；把路由注册成带方法的模式正是让它们生效的前提。响应体是框架自带的纯文本，不是信封 —— 前端不能假设所有错误都能 JSON.parse，也不能假设所有 4xx 都有信封。"
}

errmodel ENVELOPE_ERROR {
  shape = envelope
  statuses = 400, 404, 415, 422, 500, 503
  note = "daemon 自己写出的错误，走统一信封：code 是 `codes` 段声明的业务码，data 恒为 null，message 给人读。历史上这批状态码被记在 FRAMEWORK_DEFAULT 里（axum 的提取器会自产 422/415、query 解析失败自产 400），net/http 没有提取器，三个状态码一个都不会自己产生——把它们留在「框架默认」下等于契约在说自己不成立的事实。404 在这里与在框架默认里**并存**且不矛盾：路径不匹配时是框架的纯文本 404，资源存在性失败（Jail 不存在）是信封 404 + 业务码 404。"
}

# ============================================================================
# 安全头（中间件对**所有**路由统一施加）
# ============================================================================

header "X-Content-Type-Options" {
  scope = all
  value = "nosniff"
}

header "X-Frame-Options" {
  scope = all
  value = "DENY"
}

header "Content-Security-Policy" {
  scope = all
  value = "default-src 'none'"
  value_webui = "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com"
}

header "Cache-Control" {
  scope = all
  value = "no-store"
}

# ============================================================================
# 业务码（信封内的 code 字段）
# ============================================================================
#
# 与 HTTP 状态码是两套编号：HTTP 状态码表达「请求是否被处理」，业务码表达
# 「为什么失败」。同一个业务码在不同路由上可能配不同的 HTTP 状态码
# （如 40004 在 PUT /config 与 DELETE /whitelist/:cidr 上都是 400，
# 而在别处是别的语义）。

code 0 {
  status = 200
  text = "成功；message 为空串"
}

code 40001 {
  status = 400
  text = "封禁失败（内核未确认、IP 非法、或内核返回错误）"
}

code 40002 {
  status = 400
  text = "解封失败（IP 非法或内核拒绝）"
}

code 40003 {
  status = 400
  text = "批量解封临时封禁失败 / 添加白名单失败"
}

code 40004 {
  status = 400
  text = "更新配置失败 / 移除白名单失败"
}

code 40005 {
  status = 400
  text = "批量封禁参数非法（列表为空或超过 100 条）/ 日志查询参数非法"
}

code 40006 {
  status = 400
  text = "封禁详情查询失败（IP 非法）"
}

code 40007 {
  status = 422
  text = "请求体不是合法 JSON 或字段类型不符（daemon 解析，框架不会自产此码）"
}

code 40008 {
  status = 415
  text = "Content-Type 不是 application/json（本 API 只说这一种媒体类型）"
}

code 404 {
  status = 404
  text = "Jail 不存在"
}

code 50002 {
  status = 500
  text = "服务端内部错误（历史库查询任务 join 失败等），message 含具体原因"
}

code 50003 {
  status = 503
  text = "依赖未就绪：历史库未初始化 / 日志文件未配置或不可读 / jail 控制器缺席 / SSE 连接名额已满"
}

# ============================================================================
# 已核实缺陷：修复证据记在 `fix`，有意保留的理由记在 `reason`；
# 位置索引不在这里维护——路由注册串与 handler 名就是锚点。
# ============================================================================

defect HTTP_BANS_DUAL_SHAPE {
  severity = high
  status = fixed
  fix = "src/daemon/internal/http/bans.go:WriteSuccess(w, PaginatedResponse[BanResponse]{"
  resolution = "统一为单一形状：GET /api/v1/bans 一律返回分页信封 PaginatedResponse<BanResponse>（读 page / page_size / sort_by，缺省 page=1、page_size=20、上限 100），前端只保留一层返回类型。"
  text = "『data 一定是对象』这一前提曾不成立：Go 面 src/daemon/internal/http/bans.go 的 ListBans 把内存镜像**全量写成裸数组**（既不读 page/page_size 也不读 sort_by），而前端 types.ts 只声明 PaginatedResponse<BanResponse> 一层——同一份契约在两侧是两个形状，按信封取 items 的调用一律落空。旧 Rust 实现的现场是另一种表现（不带 query 返回裸数组、带了才返回信封，前端为此维护两个重载签名与运行期分支），那条现场随旧实现一并退役。Go 面现在只有一条返回路径：ListBans 经 queryPagination 读三个参数、排序后切出页内区间，写出 PaginatedResponse[BanResponse]，没有任何裸数组分支；前端 endpoints.ts 的 getBans 也只有一个签名，返回 Promise<PaginatedResponse<BanResponse>>"
}

defect HTTP_SSE_STATUS_INCOMPLETE {
  severity = medium
  status = fixed
  fix = "src/daemon/internal/http/routes.go:streamStatus(h.logStream)"
  resolution = "sse-status 载荷扩展为同时报告两条流：events 与 logs 各自的 current / max，前端按所属流的上限判断 limit_reached，不再用单一上限推断另一条流。"
  text = "/api/v1/stats/sse-status 报的是**进程级单一计数**（Go 面 routes.go 的 SSEStatus 取 server.ActiveConnections / MaxConnections），而不是两条 SSE 流各自的连接数与上限：契约给 /api/v1/events 定 10、给 /api/v1/logs/stream 定 5，Go 里两者共用同一个 broker（config.MaxSSEConnections=32）。前端用它判断『是否达到上限』会在日志流被拒时误判为未达上限，从而把 503 当成网络故障无限重连。Go 面现在按流报：SSEStatus 的载荷是 events / logs 两份读数，各自取自所在流的名额账本（Active/Max/AtLimit），上限来自生成物常量，没有第三处副本"
}

defect HTTP_RECIDIVISM_RATE_UNIT {
  severity = medium
  status = fixed
  fix = "src/daemon/internal/analysis/recommendations.go:float64(recidivistIPs) / float64(uniqueIPs) * 100"
  resolution = "统一为百分数 0–100：Go 面两处 recidivism_rate 产出点（persist/ban_events.go 的 REST 取数、analysis/recommendations.go 的阈值推荐）同为 `* 100`。契约保留的前置要求：/api/v1/stats/ban-effectiveness 接回时其各 level 必须沿用同一百分数口径，前端对两处使用同一个格式化函数。"
  text = "recidivism_rate 同名不同单位：旧 Rust 实现里 /api/v1/stats/recidivism 返回百分数（0–100）而 /api/v1/stats/ban-effectiveness 的各 level 返回比例（0–1），前端用同一个格式化函数渲染会差 100 倍。Go 重写后只剩两处产出点且都是百分数（src/daemon/internal/persist/ban_events.go 与 src/daemon/internal/analysis/recommendations.go），ban-effectiveness 当时尚未接线，因此现网上没有第二单位可比——缺陷按 Go 现状记为已修，但口径要求随 resolution 一并留在契约里。**现在前置要求也落实了**：ban-effectiveness 已接线（src/daemon/internal/http/analysis_payload.go 的 mapBanEffectiveness），各 level 与 overall 都是 `* 100` 的百分数，前端 types.ts 里那两处曾写「0.0-1.0 的比例值」的注释同步改成百分数口径（那一栏没有任何渲染分支读过它，写错只会在接回时把人带偏）"
}

defect HTTP_TODAY_BANS_EQUALS_TOTAL {
  severity = low
  status = fixed
  fix = "src/daemon/internal/http/stats.go:func startOfToday(t time.Time) time.Time"
  resolution = "today_bans 必须是真实「今日」窗口：本地时区自然日 00:00 起，按各封禁的 banned_at 计数，窗口定义与时区写进 StatsResponse.today_bans 的字段注释；REST 与 SSE 两条读路径共用同一个取值。"
  text = "today_bans 与 total_bans 取同一个值，『今日』这一时间窗从未实现，仪表盘上两个数字永远相同。Go 面接线时（契约声明的 GET /api/v1/stats 尚未注册）这条缺陷没有现场，但**不因未实现而算已修**。现在端点已接线且带真实窗口：src/daemon/internal/http/stats.go 以本地时区自然日 00:00 为起点，经 persist.CountBanEventsBetween 的半开区间 [start, end) 统计历史库 ban_events.banned_at，与 total_bans（内核自加载起的累计计数器）分属两路；结果连同近 5 分钟窗口一起缓存 30 秒（午夜切换最多晚 30 秒），REST 与 SSE 共用同一个 buildStats(now)，同一个数字不取决于它从哪条路读出来。历史库缺席时 today_bans 报 0——那一格说的是「没有读数」，不是抄一个别的计数"
}

defect HTTP_FAILURE_HISTORY_NOT_PERSISTED {
  severity = medium
  status = open
  resolution = "失败尝试与 DDoS 命中要能按时间窗回读，才谈得上热力图与趋势：持久化面需要一张按小时（或更细）归集的活动表，写入者是日志解析器与事件泵，读取者是 /api/v1/stats 的 failed_attempts_trend 与 /api/v1/stats/heatmap。在此之前这两个端点**只报已持久化的那一维**（封禁），其余槽位报 0 且不猜。"
  text = "failed_attempts 只有**本进程**的累计计数（config.GetJailStats(name).FailedAttempts），重启归零、没有按天历史；ddos_events 同理是进程内计数器（kernel.CounterDdosEvents）。于是 StatsResponse.failed_attempts_trend 无法由真源产出（Go 面写的是空标签 + 全零序列），HourlyHeatmap 的 failed_attempts 与 ddos_events 两列也恒为 0——只有 bans 一列来自历史库 ban_events 的真实时间窗。把当前累计值平摊到 7 天会凭空造出一条斜线，读图的人会当趋势看，因此这里选择报空"
}

defect HTTP_SCANNER_TOTAL_COUNT_ASYMMETRY {
  severity = medium
  status = open
  resolution = "两侧同名不同量是内核给的形状：port_scanners 的计数是内核累计检出事件数（fw_info.port_scan_detected），service_probes 的计数是本次打包带出的行数。要么内核把两个量都按同一口径给出（各配「当前在表里的地址数」与「累计检出次数」两个字段），要么契约把两个字段改成不同的名字。Go 面**原样透传**内核给的数，不在读侧把两个量伪造成相等。"
  text = "PortScanResponse.total_detected 是内核的累计检出事件计数（每次判定 +1，模块重载归零），与 scanners 的行数（最多 20 行、只带最近活跃地址）不是同一个量；ServiceProbeResponse.total_detected 是本次快照打包的行数。前端若按同一套「检出 N 个」文案渲染两处，port-scanners 那一页显示的 N 会远大于列表行数，并被读成「列表被截断了 4096 次」。形状对齐（两处都有 total_detected）由缺陷 HTTP_SERVICE_PROBE_NO_TOTAL 的闭合完成，口径差异是本条记录的独立问题"
}

defect HTTP_UDP_PORT_TOTAL_IS_PACKED_COUNT {
  severity = low
  status = open
  resolution = "内核分析快照里 udp_count / icmp_count 是**本次打包进定长载荷的行数**（遍历到 FW_ANALYSIS_*_PACK_MAX 即停），而表内真实跟踪条数在 fw_info.udp_port_count / icmp_type_count 里另有一个原子计数，没有随这条 netlink 响应带出。要把截断变成可判读的，需要内核在响应里补一个真实总数，或把打包上限提到与跟踪容量一致。Go 面原样透传，不替内核编一个它没给的总数。"
  text = "UdpPortDistributionResponse.total_entries 与 IcmpTypeDistributionResponse.total_entries 读起来像「表内共多少条」，实际是「本次带出多少行」（≤ FW_ANALYSIS_UDP_PACK_MAX=64 / ICMP=64），而 max_entries 是跟踪容量 512 / 128。于是载荷无法回答「是否还有没带出来的端口」：ports 满 64 行时可能是恰好 64 条，也可能表里已有 500 条。内核在 fw_stats.c 里遍历哈希表、装满 64 行即 break（按哈希序，不是按 packets 排序后取前 64），面板因此读到的是一个任意子集而不是 Top-64"
}

defect HTTP_THRESHOLD_RECOMMENDATION_ZERO_AMBIGUOUS {
  severity = low
  status = fixed
  fix = "src/daemon/internal/analysis/recommendations.go:recommended = current"
  resolution = "「要不要调整」由 direction 一栏单独表达（枚举 increase / decrease / maintain，载荷里同时就有它，不需要另一个字段来重复说），recommended_threshold 在 maintain 时**等于 current_threshold**（一个可直接应用的数）。契约与前端都不再用 0 当「无需调整」的哨兵：这一栏的类型是 u32，0 在那里读起来就是一个真实阈值，把它当成「不用改」等于让读侧猜编码。"
  text = "ThresholdRecommendation.recommended_threshold 的注释称『0=无需调整』（前端 frontend/src/api/types.ts 曾这么写），但 Go 面 src/daemon/internal/analysis/recommendations.go 的三个分支都不产生 0：decrease 分支把结果夹到 >= 1，increase 分支乘 1.5，maintain 分支直接 `recommended = current`。按注释判断『无需调整』的调用永远不成立。接线时核过消费方：前端没有任何一处按 0 分支渲染（Jails.tsx 读的是另一条载荷的 needs_adjustment），所以这里闭合的是**注释与算式的说法不合**而不是一个在跑的错判。现在载荷里 maintain 的条目给出与原值相同的推荐数、direction 说明不必改，契约的字段注释与 types.ts 同步改成这个口径。同一条路数还顺手补了两处只在这里可见的空转：analyzeJailTrends 在七天窗口无样本时按 ratio=0 报 falling（把「没有样本」读成「在下降」，现记 stable），jail_trends.predicted_attackers_24h 过去从来没有赋值点（恒 0），现在按截断前的全集统计"
}

defect HTTP_GEOIP_NOT_IMPLEMENTED {
  severity = medium
  status = open
  resolution = "接一个 MaxMind 读库（mmdb）：把 ban_events 里出现过的地址逐条查库，按 (国家, 城市) 聚合成 GeoPoint（同段内 unique_ips/total_bans 计数、top_ip 取封禁次数最多者、last_banned_at 取最近一次），最多 200 个并按 total_bans 降序；geoip_enabled 改为「路径存在且可读」的实测结果而不是配置项的字符串非空；server_location_source 若要给 \"detected\"，必须由 geoip_detect_egress + geoip_egress_probe_url 那条探测路径真实产出并在配置有值时让位给 \"config\"。前端 Globe.tsx 的 EmptyState 分支因此才有真正的退出条件。"
  text = "GET /api/v1/stats/attack-geo 已接线，但它**只能**报「没有地理读数」。配置项 geoip_db_path 与 geoip_detect_egress / geoip_egress_probe_url 在 src/daemon/internal/config/parser.go 里被解析并保存（applyGeoip），却没有任何消费方——仓库里没有 mmdb 读取实现，也没有 egress 探测。于是这一条恒定产出 geoip_enabled=false、points=[]、total_ips=0、located_ips=0，前端 frontend/src/views/Globe.tsx 的 `!data.geoip_enabled` 分支永远为真，整个页面停在 EmptyState：运维看不出这是「这台机器上没有地理库」还是「攻击全部来自无法定位的地址」，而全球攻击视图是面板上唯一回答「攻击从哪儿来」的一页。本机坐标三件套有真源（server_latitude/server_longitude，成对给出才生效），所以地图上的本机标记与 server_location_source=\"config\" 是可用的一半；\"detected\" 这个取值本实现不产出，也不拿猜测的经纬度冒充探测结果。这是**功能缺失**而不是数据缺失：路由、载荷与降级形状都已按契约就位，缺的是地址→坐标那一步"
}

defect HTTP_SERVICE_PROBE_NO_TOTAL {
  severity = low
  status = fixed
  fix = "src/daemon/internal/http/snapshot.go:TotalDetected: a.ServiceProbeCount"
  resolution = "ServiceProbeResponse 补 total_detected（与 PortScanResponse 形状对齐），前端两处共用同一套「检出 N 个」文案。"
  text = "ServiceProbeResponse 缺 total_detected，而同类的 PortScanResponse 有，前端在两个页面上无法用同一套『检出 N 个』文案。旧 Rust 面 service-probes 从未产出这个字段。Go 面两条端点已接线（/api/v1/stats/service-probes 与 /api/v1/stats/port-scanners），两侧现在都有 total_detected，形状差异消失。**注意闭合的只是形状**：两处同名不同量——port-scanners 带的是内核累计检出事件数，service-probes 带的是本次快照打包的行数，该口径差异由 defect HTTP_SCANNER_TOTAL_COUNT_ASYMMETRY 单独跟踪"
}

defect HTTP_HEALTH_NOT_ENVELOPED {
  severity = low
  status = retained
  reason = "探针语义：/health 与 /healthz 以 HTTP 状态码承载就绪与否（200 = 就绪，503 = 未就绪），载荷是 RuntimeSnapshot 裸 JSON。这是全项目唯一一个『状态码即语义』的端点，套信封会把语义压回 200 + code 字段，反而让 k8s/负载均衡探针无法按状态码判定。契约中显式记为有意例外而非缺陷。"
  resolution = "有意保留裸状态码（探针语义）：/health 与 /healthz 以 HTTP 状态码承载语义，在此契约中显式记为有意例外而非缺陷；前端保留 getRawJson 特判。"
  text = "/health 与 /healthz 不走信封，直接返回 RuntimeSnapshot；且未就绪时是 503 而非 5xx 信封。它是全项目唯一一个『HTTP 状态码即语义』的端点，前端必须特判（endpoints.ts 用 getRawJson）"
}

defect HTTP_LOG_SSE_LIMIT_DOC_DRIFT {
  severity = low
  status = fixed
  fix = "src/daemon/internal/http/sse.go:httpcontract.SSEMaxConnectionsApiV1LogsStream"
  resolution = "两条流各自独立计数与上限（events 10 / logs 5），并且注释只描述自己那条流；文档、常量、实现三者一致。"
  text = "契约声明两条流各自独立上限（/api/v1/events 10、/api/v1/logs/stream 5）。Go 面两个数都不存在：/api/v1/events 由 src/daemon/internal/http/sse.go 的 SSEBroker 承接，上限只有一个 `maxClients`，取自 config.MaxSSEConnections（默认 32，见 src/daemon/internal/config/types.go）；/api/v1/logs/stream 更根本没走 broker——logs.go 的 StreamLogs 每连接起一个 goroutine 直接写响应，没有任何连接计数与上限。表现：events 连到 30 条才拒，而按契约它本该在 10 条就拒；日志流则无上限，慢客户端只会把 broadcast 队列挤满（Publish 队列满时直接丢消息）。Go 面现在是一条流一个名额账本（SSEStream）：组合根分别建 NewEventsBroker 与 NewLogsStream，两者的 max 与心跳各自引用生成物常量 SSEMaxConnectionsApiV1* / SSEKeepaliveSecondsApiV1*，日志流改走同一条 streamSSE 接入路径，满额同样回 503"
}

defect HTTP_BAN_SORT_DOC_INCOMPLETE {
  severity = low
  status = fixed
  fix = "src/daemon/internal/http/bans.go:sort.SliceStable(items"
  resolution = "服务端实现并文档化同一套 7 个取值（banned_at_desc / banned_at_asc / ip_asc / ip_desc / remaining_asc / remaining_desc / jail_asc），注释、代码分支与前端 BanSortKey 三者逐字一致；未识别的取值回落 banned_at_desc。"
  text = "排序键曾三层各有说法：前端 frontend/src/api/params.ts 与 types.ts 的 BanSortKey 各列 7 个取值（types.ts 的注释还指向已删除的 ban_ops.rs），契约要求 GET /api/v1/bans 支持这些取值，而 Go 面 src/daemon/internal/http/bans.go 的 ListBans **一个都不实现**——它不读 sort_by，连 page/page_size 也不读。旧现场（Rust 的 sort_by 文档只列 4 值、实现 7 值）随旧实现退役。现在服务端有一份 banSortKeys 表承载全部 7 个分支（每项一个比较闭包），ListBans 取 params.sortByOr() 查表、未识别的值回落 banned_at_desc，取值集合与前端 params.ts / types.ts 的 BanSortKey 逐字相同"
}

defect HTTP_READ_PATH_WRITES_STATE {
  severity = high
  status = fixed
  fix = "src/daemon/internal/kernel/consumer.go:p.cache.SweepExpired(secs)"
  resolution = "读路径只读：过期封禁的清扫由内核事件泵的对账周期独占驱动，HTTP handler 一律只从内存镜像/快照取数。"
  text = "get_active_bans() 曾在**读**路径上按 5 秒节流执行 purge_expired，顺带自增 total_unbans 并写入封禁时长统计。旧 SSE 每个 tick（默认 1 秒）都会读一次，于是「每秒被读一次的统计」被读路径自己改写——读数与写入者互相污染，仪表盘上的解除封禁计数不可复现。Go 重写后这一形状不复存在：src/daemon/internal/http/bans.go 与各统计 handler 只做取数写出，清扫与计数都在 kernel/consumer.go 的 reconcile 里（`p.cache.SweepExpired(secs)`），读侧没有任何写点。机械探针的覆盖面也跟着改：原先硬编的 12 个 handler 名单里留着 4 条 Rust 时代的死名字，取不到函数体时**静默跳过**，于是过期名单会被读成「现场已消失」；现在扫描名单由注册表推导（除静态外壳外的每一条 GET handler），取不到函数体即报现场仍在"
}

defect HTTP_SSE_RESERIALIZES_EVERY_DOMAIN {
  severity = medium
  status = fixed
  fix = "src/daemon/internal/http/sse.go:case b.broadcast <- frame"
  resolution = "序列化只发生在**内容变化时的一次 publish** 上：broker 把载荷 marshal 一次，再广播给各连接的 channel；没有按连接、按 tick 重复序列化的循环。"
  text = "旧 SSE 每个 tick 把 5 份载荷（stats/bans/jails/whitelist/rates）全量 serde_json::to_string 一遍，无论有没有变化，且这段序列化在**每条连接**的循环里各做一次。成本是「连接数 × 域数 × 每秒一次」：安静时段也在重复序列化同样的内容，payload 越大越明显。Go 面改成了事件驱动：kernel/consumer.go 只在采样后比较快照、变了才 Publish，sse.go 的 Publish 经 sseFrame 每个事件 marshal 一份 bytes 后投递给各连接 channel（队满丢弃），连接循环只搬运不再序列化"
}

defect HTTP_SSE_JAILS_NO_PUBLISHER {
  severity = medium
  status = open
  resolution = "jails 域必须有真实生产者：写入点（jail 启用/禁用、内核 jail 配置变化）显式 Publish 该域，前端订阅侧因此能在变更后收到新帧，而不是只在整页刷新时重收首帧。"
  text = "契约把 jails 列为 /api/v1/events 的订阅域，但 Go 面没有任何 jails 发布者：src/daemon/internal/kernel/consumer.go 的发布域常量只有 DomainBans、DomainWhitelist、DomainStats、DomainRates，采样周期变化的也只有 stats/rates 一类数值域。前端订阅 jails 后取值写作 sseJails ?? restJails.data，SSE 一旦有过首帧，REST 那份永远取不到，于是写后的 reload() 与页内刷新按钮全是死代码——改 Jail 开关后界面弹「已启用」，开关却弹回原位，只有整页刷新（重连 SSE、重收首帧）才看得到新值。旧实现靠每个 tick 无条件重发全部 5 个域掩盖了「jails 没有真实变更触发」，按域推送把掩盖拿掉后缺失的生产者就暴露成用户可见的不更新。REST 侧的数据源这一半已就位（执行体在装配、热重载、回滚、内核指令与启用状态同步时发布 jail 配置快照，见 GET /api/v1/jails 的注释），本缺陷未闭合的仍是**变更触发上的 SSE 生产者**：快照更新了，订阅者收不到"
}

defect HTTP_WHITELIST_KEY_DIVERGENCE {
  severity = medium
  status = fixed
  fix = "src/daemon/internal/bans/global.go:prefix.Masked().String()"
  resolution = "键的规范化只有一处：网络地址（主机位清零）+ 恒带 /prefix（裸地址即 /32、/128）。Go 面白名单镜像经 bans/global.go 的 whitelistKey，检测侧聚合键经 detect/cidr.go 的 NewCidrKey，两处同用 netip.Prefix.Masked()。"
  text = "白名单的键曾有三套互不相同的规则：LIST 响应恒带 /prefix；事件路径对 /32·/128·/0 存裸地址；build_cidr_key 又把 IPv6 /0 归一成 /128。同一子网因此会拿到两个键，LIST 的整表覆盖打不中事件插入的那一条，表现为「白名单里看到两条同一个网段」或「删了还在」。三套规则分别位于旧实现的 ban/mod.rs、netlink/handlers.rs 与 web_ui/ban_ops.rs，随 Rust daemon 一并退役；Go 面归一化收在一处（bans/global.go 的 whitelistKey 与 detect/cidr.go 的 NewCidrKey 都用 Masked()），与内核侧 fw_addr_normalize 的形状一致"
}

defect HTTP_BATCH_BAN_BECOMES_PERMANENT {
  severity = high
  status = fixed
  fix = "src/daemon/internal/http/bans.go:duration := uint64(banDefaultBatchSecs)"
  resolution = "批量封禁显式下发有时长（契约里 duration 缺省即 3600 秒），并且只有显式 `permanent = true` 才产生永久封禁；`duration` 缺省/0 一律不得升格为永久。请求体形状与上限按契约：`{ips, duration, reason}`，单次 1..100 条，越界返回业务码 40005。"
  text = "『多选若干 IP → 批量封禁』曾在确认弹窗承诺『统一使用 3600 秒』的情况下把这批 IP 全部永久封禁。Go 面的现场与旧实现同源：src/daemon/internal/http/bans.go 的 BatchBan 写作 `isPermanent := req.Duration == 0`，请求体不带 duration 就是永久。两个次生后果一条是退路、一条是形状：① /api/v1/bans/unban-temporary 只解封临时封禁，这些条目它看不见（total=0）；② 前端 endpoints.ts 的 batchBan 曾 POST 裸 `string[]`，与服务端解的 `{ips, duration, reason}` 不同形。现在 BatchBan 解的是契约的 BatchBanRequest，`IsPermanent` 恒为 false、到期时间按 `duration` 缺省 3600 秒算出，越界（空列表 / >100 条）在任何一条封禁落下之前整批回 40005；前端 batchBan 也改为发送同形对象，注释与契约的 100 条上限一致"
}

# ============================================================================
# 路由表
# ============================================================================
#
# `returns` 取 type | text | bytes | stream：
#   type   经信封返回 JSON 载荷（data 的类型见同名 type/request 块）
#   text   不经信封，直接返回纯文本（静态资源未命中等）
#   bytes  二进制（sw.js 等静态文件）
#   stream 长连接 SSE（必须声明 max_connections 与 events）
#
# `status` 是**成功**路径的 HTTP 状态码；`alt_status` 是同一路由上另一个
# 「成功但语义不同」的状态码（如 201 Created 与 200 OK 并存）。失败状态码
# 由 codes 对应的业务码隐含（见 code 块）。

# ---- 无认证：健康检查 -------------------------------------------------------

route GET "/health" {
  auth = none
  handler = handle_health
  returns = type
  status = 200
  alt_status = 503
  note = "唯一『HTTP 状态码即语义』的端点：200 = status==\"ok\"，503 = 未就绪。载荷直接是 RuntimeSnapshot，不经信封（见 defect HTTP_HEALTH_NOT_ENVELOPED）。"
}

route GET "/healthz" {
  auth = none
  handler = handle_health
  returns = type
  status = 200
  alt_status = 503
  note = "与 /health 同函数，供 k8s/负载均衡探针使用"
}

# ---- 无认证：SPA 外壳与静态资源 ---------------------------------------------
#
# 这些路由返回的都是**不含运行时数据**的静态壳；所有数据一律经受保护的
# /api/v1/* 取用。因此公开不泄露状态，且浏览器直接打开页面、加载子资源都不
# 需要凭据（若放进认证组，配了凭据后页面反而打不开）。

route GET "/" {
  auth = none
  handler = handle_redirect
  returns = text
  status = 303
  note = "重定向到 /dashboard；**必须原样保留 query string**，否则 /?access_token=<token> 直达会丢凭据。状态码固定为 303 See Other（不是 302）：303 明确表达「响应是另一个资源、原请求无副作用」，浏览器对两者的 GET 重定向行为一致。"
}

route GET "/dashboard" {
  auth = none
  handler = handle_dashboard
  returns = text
  status = 200
}

route GET "/bans" {
  auth = none
  handler = handle_spa_bans
  returns = text
  status = 200
}

route GET "/whitelist" {
  auth = none
  handler = handle_spa_whitelist
  returns = text
  status = 200
}

route GET "/jails" {
  auth = none
  handler = handle_spa_jails
  returns = text
  status = 200
}

route GET "/ddos" {
  auth = none
  handler = handle_spa_ddos
  returns = text
  status = 200
}

route GET "/globe" {
  auth = none
  handler = handle_spa_globe
  returns = text
  status = 200
}

route GET "/logs" {
  auth = none
  handler = handle_spa_logs
  returns = text
  status = 200
}

route GET "/settings" {
  auth = none
  handler = handle_spa_settings
  returns = text
  status = 200
}

route GET "/more" {
  auth = none
  handler = handle_spa_more
  returns = text
  status = 200
}

route GET "/static/*path" {
  auth = none
  handler = handle_static
  returns = bytes
  status = 200
  alt_status = 404
  note = "未命中时返回纯文本 \"404 Not Found\\n\"（errmodel STATIC_NOT_FOUND）"
}

route GET "/sw.js" {
  auth = none
  handler = handle_sw
  returns = bytes
  status = 200
  alt_status = 404
  note = "带 Service-Worker-Allowed: / 与 Cache-Control: no-cache；浏览器注册 SW 时不带交互式凭据，放进认证组会 401 导致注册失败"
}

# ---- 需认证：指标与 SSE -----------------------------------------------------

route GET "/metrics" {
  auth = required
  handler = handle_metrics
  returns = text
  status = 200
  note = "Prometheus 文本格式 text/plain; version=0.0.4; charset=utf-8"
}

route GET "/api/v1/events" {
  auth = required
  handler = handle_sse
  returns = stream
  status = 200
  alt_status = 503
  codes = 50003
  max_connections = 10
  events = connected, stats, bans, jails, whitelist, rates
  keepalive_secs = 15
  note = "超过 10 连接返回 503。keep-alive 事件文本为 \"keep-alive\"。"
}

route GET "/api/v1/logs/stream" {
  auth = required
  handler = handle_log_stream
  returns = stream
  status = 200
  alt_status = 503
  codes = 50003
  max_connections = 5
  events = connected, log, error
  keepalive_secs = 15
  note = "上限 5 与 /api/v1/events 的 10 **各自独立**；keep-alive 文本同为 \"keep-alive\"。"
}

# ---- 需认证：统计总览 -------------------------------------------------------

route GET "/api/v1/stats" {
  auth = required
  handler = handle_api_stats
  returns = type
  status = 200
  note = "载荷 StatsResponse：首屏总览，一张混合三路真源的表——内核统计快照（current_bans / total_bans / total_unbans / whitelist_count / packets_dropped / packets_accepted）、历史库时间窗（today_bans 的本地自然日窗口、threat_level.recent_bans 的最近 5 分钟，两者共缓存 30 秒）、本进程状态（failed_attempts / ddos_events / uptime_seconds、各图）。各字段的来源与口径写在 StatsResponse 的字段注释里。这条路由只声明 code 0：历史库缺席或查询失败时那几项报 0 / 空序列，快照陈旧照原样报，不把首屏整体判成失败——一半数字拿不到时也要把另一半画出来"
}

# ---- 需认证：封禁管理 -------------------------------------------------------

route GET "/api/v1/bans" {
  auth = required
  handler = handle_api_bans
  returns = type
  status = 200
  codes = 0
  note = "**单一形状**：一律返回分页信封 PaginatedResponse<BanResponse>（读 page / page_size / sort_by，缺省见 request PaginationParams），不得有裸数组分支。排序键是契约的 7 个取值，未识别的值回落 banned_at_desc——见 defect HTTP_BANS_DUAL_SHAPE 与 HTTP_BAN_SORT_DOC_INCOMPLETE（两条均 fixed）。"
}

route POST "/api/v1/bans" {
  auth = required
  handler = handle_create_ban
  returns = type
  status = 201
  alt_status = 200
  codes = 40001, 40007, 40008
  note = "请求体 CreateBanRequest；成功 201 Created，载荷 BanOperationResponse。`duration` 三态：缺席与显式 0 都是**永久**，显式正数是时长（与 JailResponse.ban_time 的「负值=永久」是两套编码，别串用）。成功路径同时写 ban_events 底账（jail_name 固定 \"api\"）与 ban_history，任一步失败回 40001 并在 message 里说明是内核未确认、IP 非法还是内核返回错误——契约给这条路由只编了这一个失败码，区分靠 message 不靠新造数字。"
}

route DELETE "/api/v1/bans/:ip" {
  auth = required
  handler = handle_delete_ban
  returns = type
  status = 200
  codes = 40002
}

route GET "/api/v1/bans/:ip/detail" {
  auth = required
  handler = handle_ban_detail
  returns = type
  status = 200
  codes = 40006
  note = "载荷 BanDetailResponse"
}

route POST "/api/v1/bans/unban-temporary" {
  auth = required
  handler = handle_unban_temporary
  returns = type
  status = 200
  codes = 40003
}

route POST "/api/v1/bans/batch" {
  auth = required
  handler = handle_batch_ban
  returns = type
  status = 201
  alt_status = 200
  codes = 40005, 40007, 40008
  note = "请求体 BatchBanRequest（`{ips, duration, reason}`，单次 1..100 条）；空列表或超过 100 条 → 40005；成功 201 Created，载荷 BatchOperationResponse。duration 缺省按 3600 秒**有时长**封禁，不得升格为永久——见 defect HTTP_BATCH_BAN_BECOMES_PERMANENT（fixed）。每条成功的封禁都同时落 ban_events 底账（jail_name 固定 \"api\"、ban_count 记 1）与 ban_history，因此批量路径的封禁也会出现在复发统计、分级成效与时长直方图里——过去只有自动封禁进底账，面板上的「被封几次」会漏掉手工封禁。"
}

# ---- 需认证：Jail -----------------------------------------------------------

route GET "/api/v1/jails" {
  auth = required
  handler = handle_api_jails
  returns = type
  status = 200
  note = "载荷 JailResponse 数组（按配置顺序，不排序）。这条路由**不编业务码**：jail 配置出自内存，历史库缺席不影响它，读侧不会收到 50002/50003。配置与启用状态读的是运行时发布的 jail 配置快照——属主是执行体，在装配、热重载、回滚、内核指令与启用状态同步时发布，改名或删除的 jail 随下一次发布从表里消失，读侧不会看到配置与快照各一半的形状。运行时计数（lines_parsed…bans_triggered）是本进程累计值，重启归零；ban_count 是当前活跃封禁数而非历史累计（见 JailResponse 的字段注释）"
}

route PUT "/api/v1/jails/:name" {
  auth = required
  handler = handle_update_jail
  returns = type
  status = 200
  codes = 404, 40007, 40008, 50003
  note = "请求体 UpdateJailRequest；Jail 不存在 → 404（信封内 code=404，非 HTTP 404）"
}

