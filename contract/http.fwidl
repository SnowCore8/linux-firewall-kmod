}

# ---- 需认证：速率 -----------------------------------------------------------

route GET "/api/v1/rates/current" {
  auth = required
  handler = handle_api_rates_current
  returns = type
  status = 200
  note = "载荷 RateResponse 数组，不分页：内核速率表的容量（FW_RATE_CPU_SLOTS=512 个在跟踪的源地址）在一次响应带得下，事件泵也是整表取回。行来自事件泵快照，服务端按 packets_per_sec 降序、同值按 IP 升序（内核按哈希序回表，不排序会让同一个地址在两次刷新之间跳到图的另一端）。速率是内核给的**自上次查询以来的平均**，不是瞬时值；地址族无法识别的条目丢弃并记日志，不把空串当 IP 写出去"
}

route GET "/api/v1/rates/history" {
  auth = required
  handler = handle_api_rates_history
  returns = type
  status = 200
  note = "载荷 RateHistoryResponse **数组**，时间升序（最早在前，折线图直接按 x 轴递增画）。数据源是守护进程侧的速率历史环（internal/telemetry/rate_history.go）：事件泵每成功问一次内核速率表落一个点，节奏 = 采样周期（当前 5 秒），容量 720 点 ≈ 1 小时。查询参数 limit 取最近 n 个点，上限与默认都是环容量——要更多时环里也没有，回一批零等于伪造历史。采样中断留下的是**空洞**而不是补出来的零点；环是进程内的，重启后从空开始。曾经有一条从 /proc/firewall/rates 解析历史的路径，那个格式内核从未产出过，端点因此恒在走降级分支"
}

route GET "/api/v1/rates/windows" {
  auth = required
  handler = handle_api_rates_windows
  returns = type
  status = 200
  note = "载荷 RateWindowSnapshot：三档窗口（短期/中期/长期）各一对 pps、bps。窗口是**守护进程侧的派生量**（EWMA），内核没有窗口概念、只回答自上次查询以来的平均速率，所以这条路由的数据源是快照的 Windows 字段而不是内核。平滑值本身是浮点，载荷按契约的 u64 四舍五入——截断会把 0.6 pps 报成 0，读成「完全没有流量」"
}

# ---- 需认证：统计子路由 ----------------------------------------------------
#
# 这一族按「读失败会怎样」分两类，两类都在 200 信封里给结论，区别只在有没有 5xx：
# **不声明 codes** 的读数来自内核快照或历史库的时间窗聚合，读不到就在载荷里报零值/
# 空数组（快照缺席不等于服务坏了）；带 `codes = 50002, 50003` 的是历史库分析族，
# 整页数据都建在一次查询上，查询失败只能报错而不是给一张全零的图。

route GET "/api/v1/stats/heatmap" {
  auth = required
  handler = handle_api_heatmap
  returns = type
  status = 200
  note = "载荷 HourlyHeatmap：24 个 HourlyBucket 的定长数组，hour 是**本地时区**的自然小时槽（0-23），bans 把最近 7 个自然日的封禁按小时归槽后叠在一起（热力图读的是「哪个钟点最容易被打」，不是某一天的小时分布）；缺数据的小时保留为全零行而不是跳过，数组长度恒为 24。failed_attempts 与 ddos_events 两列恒为 0（见 defect HTTP_FAILURE_HISTORY_NOT_PERSISTED）"
}

route GET "/api/v1/stats/recidivism" {
  auth = required
  handler = handle_api_recidivism
  returns = type
  status = 200
  codes = 50002, 50003
  note = "载荷 RecidivismResponse；其 recidivism_rate 是**百分数 0-100**（见 defect HTTP_RECIDIVISM_RATE_UNIT）"
}

route GET "/api/v1/stats/ban-effectiveness" {
  auth = required
  handler = handle_api_ban_effectiveness
  returns = type
  status = 200
  note = "载荷 BanEffectivenessResponse；其中 recidivism_rate（含 overall_recidivism_rate 与各 level 的）统一为**百分数 0-100**，与 /api/v1/stats/recidivism 同一个口径，前端两处共用同一个格式化函数（见 defect HTTP_RECIDIVISM_RATE_UNIT 的 resolution）。**不编业务码 = 历史库未初始化或查询失败也在 200 内降级**：levels 为 []、total_unique_ips/overall_recidivism_rate 为 0，summary 分别写「历史库未初始化：没有封禁底账…」与「封禁底账查询失败：本次没有分级成效读数」——面板上同一句「无样本」背后的两种原因必须能分开，否则运维不知道是该等数据还是该修库（服务端各留一条日志）"
}

route GET "/api/v1/stats/periodic-attackers" {
  auth = required
  handler = handle_api_periodic_attackers
  returns = type
  status = 200
  codes = 50002, 50003
  note = "载荷 PeriodicAttacker 数组"
}

route GET "/api/v1/stats/collaborative-attacks" {
  auth = required
  handler = handle_api_collaborative_attacks
  returns = type
  status = 200
  codes = 50002, 50003
  note = "载荷 CollaborativeAttack 数组"
}

route GET "/api/v1/stats/udp-ports" {
  auth = required
  handler = handle_api_udp_ports
  returns = type
  status = 200
  note = "载荷 UdpPortDistributionResponse：ports 最多 64 行（FW_ANALYSIS_UDP_PACK_MAX），行按端口升序以便两次刷新可比。total_entries 是**本次快照带出的行数**而不是表内总数，max_entries 是跟踪容量 512——载荷因此无法回答「是否还有没带出来的端口」，见 defect HTTP_UDP_PORT_TOTAL_IS_PACKED_COUNT"
}

route GET "/api/v1/stats/icmp-types" {
  auth = required
  handler = handle_api_icmp_types
  returns = type
  status = 200
  note = "载荷 IcmpTypeDistributionResponse：截断口径与 udp-ports 相同（types 最多 64 行，total_entries 是带出的行数，max_entries 是跟踪容量 128），同见 defect HTTP_UDP_PORT_TOTAL_IS_PACKED_COUNT"
}

route GET "/api/v1/stats/sse-status" {
  auth = required
  handler = handle_api_sse_status
  returns = type
  status = 200
  note = "载荷 SseStatusResponse（events / logs 各一份 SseStreamStatus）：两条流各自的上限与当前连接数都可见，前端按所属流判断 limit_reached，不得用一条流的上限推断另一条（缺陷 HTTP_SSE_STATUS_INCOMPLETE 已按此形状闭合）。"
}

route GET "/api/v1/stats/ban-duration-histogram" {
  auth = required
  handler = handle_api_ban_duration_histogram
  returns = type
  status = 200
  note = "载荷 BanDurationHistogramResponse。样本是一次取最近 10000 条 ban_events（分布需要样本厚度，上限同时也是读取成本的闸门；该列无索引，走的是全表尾部）。**不编业务码**：库缺席或查不动时同样在 200 内回「6 个标签 + 全 0 计数 + total=0」。**没有 limit 查询参数**——这一条报的是分布而不是列表，条数由桶数决定。桶边界与 total 的口径见该类型的注释（迁移前的旧行没有时长读数，不进桶也不进 total）"
}

route GET "/api/v1/stats/packet-sizes" {
  auth = required
  handler = handle_api_packet_sizes
  returns = type
  status = 200
  note = "载荷 PacketSizeDistributionResponse：5 个长度桶，labels/counts/percentages 等长同下标。计数是**自模块加载起的累计值**（内核那组数组只在 init/unload 归零，flush 只搬 accept/drop 那组），横轴不是时间窗口——面板读的是「本机见过什么样的包」而不是「最近 5 秒长什么样」。读数来自事件泵快照，链路断开时是上一次成功采样的陈旧值"
}

route GET "/api/v1/stats/ttl-distribution" {
  auth = required
  handler = handle_api_ttl_distribution
  returns = type
  status = 200
  note = "载荷 TtlDistributionResponse：6 个 TTL 桶，累计口径与 packet-sizes 相同（自模块加载起，不是时间窗口），labels/counts/percentages 等长同下标"
}

route GET "/api/v1/stats/ip-fragments" {
  auth = required
  handler = handle_api_ip_fragments
  returns = type
  status = 200
  note = "载荷 IpFragmentStatsResponse：total_packets 是**所有**被记账的 IP 包（内核逐包累加），fragment_packets 只数分片，fragment_ratio 因此是百分数 0-100；累计口径同 packet-sizes。总数为 0 时比例取 0 而不是 NaN——encoding/json 遇到 NaN 会直接报错、整个响应发不出去"
}

route GET "/api/v1/stats/port-scanners" {
  auth = required
  handler = handle_api_port_scanners
  returns = type
  status = 200
  note = "载荷 PortScanResponse：scanners 最多 20 行（内核只带最近活跃的地址），threshold 是判定阈值。total_detected 是内核的**累计检出事件计数**（fw_info.port_scan_detected，每次判定 +1、模块重载归零），与行数不是同一个量，见 defect HTTP_SCANNER_TOTAL_COUNT_ASYMMETRY"
}

route GET "/api/v1/stats/service-probes" {
  auth = required
  handler = handle_api_service_probes
  returns = type
  status = 200
  note = "载荷 ServiceProbeResponse：probes 最多 20 行，threshold 是判定阈值。total_detected 与 port-scanners 同名，但这一侧带的是**本次快照打包的行数**而不是累计检出数——形状对齐（两处都有该字段）由 defect HTTP_SERVICE_PROBE_NO_TOTAL 闭合，口径差异见 HTTP_SCANNER_TOTAL_COUNT_ASYMMETRY，读侧不把两个量伪造成相等"
}

route GET "/api/v1/stats/ban-duration-recommendations" {
  auth = required
  handler = handle_api_ban_duration_recommendations
  returns = type
  status = 200
  codes = 50002, 50003
  note = "载荷 BanDurationRecommendationResponse"
}

route GET "/api/v1/stats/reputation" {
  auth = required
  handler = handle_api_reputation
  returns = type
  status = 200
  codes = 50002, 50003
  note = "载荷 ReputationEntryResponse 数组；threshold_multiplier 由内联分段函数生成（1.0 / 0.8 / 0.5）"
}

route GET "/api/v1/stats/threshold-recommendations" {
  auth = required
  handler = handle_api_threshold_recommendations
  returns = type
  status = 200
  codes = 50002, 50003
  note = "载荷 ThresholdRecommendationResponse（recommended_threshold 的 0 语义见 defect HTTP_THRESHOLD_RECOMMENDATION_ZERO_AMBIGUOUS）"
}

route GET "/api/v1/stats/network-distribution" {
  auth = required
  handler = handle_api_network_distribution
  returns = type
  status = 200
  codes = 50002, 50003
  note = "载荷 NetworkBlock 数组"
}

route GET "/api/v1/stats/attack-predictions" {
  auth = required
  handler = handle_api_attack_predictions
  returns = type
  status = 200
  codes = 50002, 50003
  note = "载荷 AttackPredictionSummary"
}

route GET "/api/v1/stats/anomalies" {
  auth = required
  handler = handle_api_anomalies
  returns = type
  status = 200
  note = "异常检测：全局流量偏离 + per-IP 行为离群；载荷 AnomalyResponse。两路各有真源且都不猜：全局用**速率历史环**（一个点 = 事件泵问内核一次，容量 720 点 ≈ 1 小时），当前值取最新一个点，行数未达最小样本护栏（10）时整段基线不给——global_features 写成 null（本轮没有当前值），global_dimensions 与两条基线是**空数组**而不是 null，因为前端对它们做 .map()，null 会让整页崩而空数组只是少几根柱子；per-IP 用**同一份快照**里的速率表做横向比较（当前这批被跟踪地址之间谁最不像同伴），地址数未达 5 时列表为空。global_score 是 0-100，维度分是 0-1 归一化。这条路由只观测，不触发任何封禁——封禁判据在 detect/decision 的阈值里，两者口径不同"
}

# 异常检测载荷。只观测、不触发任何封禁。
#
# `global_features` 为 null 表示本轮样本不足（未达最小样本护栏），此时
# `global_dimensions` 与两条基线为空数组、`global_score` 为 0。
type AnomalyResponse {
  # 全局异常评分（0-100）
  global_score: f64
  # 全局各维度偏差分（0-1 归一化）
  global_dimensions: Vec<DimensionScore>
  # 全局当前特征值；样本不足时为 null
  global_features: Option<Vec<FeatureValue>>
  # 全局 p50 基线
  global_baseline_p50: Vec<FeatureValue>
  # 全局 p95 基线
  global_baseline_p95: Vec<FeatureValue>
  # 滚动窗口样本数
  global_sample_count: usize
  # per-IP 异常列表（按评分降序，最多 20 条）
  ip_anomalies: Vec<IpAnomalyEntry>
  # 最近更新时间戳（Unix 秒）
  timestamp: i64
}

# 单维度偏差分；`name` 取自该维度的维度名表（全局与 per-IP 各自一套）。
type DimensionScore {
  name: String
  # 偏差分（0-1）
  score: f64
}

type FeatureValue {
  name: String
  value: f64
}

type IpAnomalyEntry {
  ip: String
  # 异常评分（0-100）
  score: f64
  # 各维度偏差分
  dimensions: Vec<DimensionScore>
}

route GET "/api/v1/stats/attack-geo" {
  auth = required
  handler = handle_api_attack_geo
  returns = type
  status = 200
  note = "攻击源地理分布；载荷 AttackGeoResponse。**不编业务码**：这条恒成功。当前实现**没有 GeoIP 读库**（见 defect HTTP_GEOIP_NOT_IMPLEMENTED），因此 geoip_enabled 恒为 false、points 恒为 []、total_ips/located_ips 恒为 0——这是「没有读数」而不是「没有攻击来自远方」。本机坐标三件套有真源（配置项 server_latitude/server_longitude，必须成对给出）：设了就回数值 + source=\"config\"，没设就两个 null + source=\"none\"。契约里的第三个取值 \"detected\"（由 egress 探测推断，配置项 geoip_detect_egress）本实现没有做，不拿猜出来的经纬度冒充探测结果"
}

# 攻击源地理分布载荷。
#
# `geoip_enabled=false`（数据库未装配）时 points 为空、total_ips/located_ips 为 0，
# 本机坐标三件套仍照常返回（它们不依赖地理库）。**当前实现就停在这个分支上**：
# 配置项 geoip_db_path 没有任何消费方，见 defect HTTP_GEOIP_NOT_IMPLEMENTED。
type AttackGeoResponse {
  # 地理解析是否可用（数据库是否已装配且可用）
  geoip_enabled: bool
  # 按总封禁数降序的地点（最多 200 个）
  points: Vec<GeoPoint>
  # 参与本次统计的 IP 总数（含无法定位的）
  total_ips: u32
  # 成功定位的 IP 数
  located_ips: u32
  # 本机纬度；未配置且未探测到时为 null（前端据此不画本机标记与弧线）
  server_latitude: Option<f64>
  # 本机经度；语义同 server_latitude
  server_longitude: Option<f64>
  # 本机坐标来源（config / detected / none）；detected 是非权威值，界面须能区分
  server_location_source: String
}

type GeoPoint {
  latitude: f64
  longitude: f64
  # 国家 ISO 代码（如 CN）
  country_code: String
  country: String
  # 城市名（可为空）
  city: String
  # 一级行政区名（可为空）
  subdivision: String
  # 该位置被封禁的唯一 IP 数
  unique_ips: u32
  # 该位置的总封禁次数
  total_bans: u32
  # 该位置的代表性 IP（封禁次数最多者）
  top_ip: String
  # 该位置最近一次封禁时间（Unix 秒）
  last_banned_at: i64
}

# ---- 需认证：日志 -----------------------------------------------------------

route GET "/api/v1/logs" {
  auth = required
  handler = handle_api_logs
  returns = type
  status = 200
  codes = 40005, 50002, 50003
  note = "查询参数 LogQueryParams；分页参数非法 → 40005；载荷 LogPageResponse"
}

# ============================================================================
# 载荷类型
# ============================================================================
#
# 字段名一律是**线上 JSON 的 key**（不是 Go 结构体字段名）。`type`、`method`
# 这类在语言里是关键字的 key 在这里照写线上拼写，实现侧用序列化 tag 映射。
#
# 只声明**同时存在于** daemon 响应结构与前端 types.ts 的字段——契约的
# 价值在跨层对齐，daemon 内部专有结构（AnalysisData、BanHistory 等）不入契约。
#
# `request` 块表示请求体（daemon 侧 #[derive(Deserialize)]，前端由调用点的
# 泛型参数体现，不单独在 types.ts 声明）。

# ---- 信封与分页 -------------------------------------------------------------

type ApiResponse<T> {
  code: i32
  data: T
  message: String
}

type PaginatedResponse<T> {
  items: Vec<T>
  total: u64
  page: u32
  page_size: u32
  total_pages: u32
}

# ---- 运行时状态 -------------------------------------------------------------

type RuntimeSnapshot {
  status: &'static str
  # 内核是否会接受本进程的指令：等价于「租约已持有（lease_state == "held"）」。
  # 旧口径是「netlink 上下文存在即可」，那会把「socket 建好但内核不认」报成就绪。
  netlink_ready: bool
  kmod_proc_present: bool
  ban_cache_initialized: bool
  ban_history_initialized: bool
  active_bans: usize
  # 内核单实例注册租约的状态：none / idle / held / refused / lost。
  # 内核同一时刻只承认一个 daemon portid，非 held 时本进程的指令会被静默丢弃。
  lease_state: &'static str
  # 进入 lost 的累计次数。*某一刻* 的状态快照看不出一段时间内的反复失联。
  lease_losses: u64
}

# ---- 统计总览 ---------------------------------------------------------------

type StatsResponse {
  daemon_version: String
  # 内核模块版本，读自 /sys/module/firewall/version；模块未加载时为空串（「读不到」
  # 与「版本是 0」要能分开，所以不用 0 表示缺席）
  kernel_version: String
  # 窗口定义：本地时区自然日 00:00 起（时区取守护进程解析出的本地 Location，刻意不用
  # UTC——看板上的「今日」跟运维日历走，按 UTC 日起算会把凌晨的封禁算进昨天）。
  # 计数口径：历史库 ban_events 表中 banned_at 落在半开区间 [今日 00:00, 次日 00:00)
  # 内的行数——闭区间会让午夜那条被「今日」与「昨日」各数一次。
  # 与 total_bans（内核自模块加载起的累计计数器）是两个不同的量：本字段带真实时间窗，
  # 且跨守护进程重启保持连续。结果缓存 30 秒，故午夜切换最多晚 30 秒；REST 与 SSE 的
  # stats 域共用同一个装配函数，同一个数字不取决于它从哪条读路径被取出来。
  today_bans: u64
  # 各 jail 的失败尝试之和，来自**本进程**的配置态统计：重启归零、没有按天的历史
  # （见 defect HTTP_FAILURE_HISTORY_NOT_PERSISTED）
  failed_attempts: u64
  # 本进程收到的内核 DDoS 命中次数：事件泵每收到一次 DdosEvent 加一，重启归零
  ddos_events: u64
  # 守护进程自己的运行时长（组合根记下启动时刻），不是机器 uptime、也不是模块加载时长
  uptime_seconds: u64
  # 最近 7 个**本地自然日**的封禁数（来自历史库 ban_events，标签为月-日）
  ban_trend: ChartData
  # 活跃封禁按 jail 的分布（内存镜像，与 current_bans 同源）；计数为 0 的 jail 不进图
  jail_distribution: ChartData
  failure_reasons: ChartData
  # 无按天历史，恒为空标签 + 全零序列（见 defect HTTP_FAILURE_HISTORY_NOT_PERSISTED）；
  # 不把当前累计值平摊到 7 天——那是一条凭空造的斜线，读图的人会当趋势看
  failed_attempts_trend: ChartData
  # 以下五项来自内核统计快照的最新一刻：链路断开时它们是**上一次成功采样的陈旧值**，
  # 新鲜度的判据在 /health 的链路字段，这条路由不为「读数陈旧」另造错误码
  current_bans: u64
  total_bans: u64
  total_unbans: u64
  whitelist_count: u64
  packets_dropped: u64
  packets_accepted: u64
  threat_level: ThreatLevel
}

type ChartData {
  labels: Vec<String>
  values: Vec<u64>
}

type ThreatLevel {
  # score 的字符串形式，取值 safe / low / medium / high / critical（与前端 types.ts 逐字一致）
  level: String
  # 三路信号（速率倍数、封禁表占用率、近 5 分钟封禁数）分档后的**最大值**，0-4。
  # 取最大而不是求和：三者量纲不同，相加会把两路「值得关注」折成一路「危急」；
  # 占用率一路最高只到 3
  score: u8
  # 只列触发了等级判定的那几路（分档 > 0）；没有任何一路触发时是单条「一切正常」。
  # 全塞进去会让面板在安全时也显示一串「速率 0.0 倍、占用 0%」这类没有读者的读数
  factors: Vec<String>
  # 短期 EWMA 的当前全局 pps（四舍五入到整数），不是内核的瞬时读数
  current_pps: u64
  # 短期 EWMA 相对**有效基线**的倍数。基线是与三档窗口分开维护的一条慢速 EWMA，有效基线
  # 在峰值时段乘 PeakMultiplier=1.5；基线尚未建立（有效值 <=0）时本字段取 0，因此不加分
  # ——「还没学会基线」不会被伪装成某个具体等级的结论
  pps_ratio: f64
  # 0-1 的**比例**（不是百分数）：current_bans / 守护进程配置的条目上限
  # （config.Capacity.MaxBanEntries，与下发给模块的 fw_max_ban_entries 同一个值）。
  # 内核没有把实时上限带进 netlink 统计响应，分母只能取配置值；配置缺席或上限为 0 时
  # 报 0。本字段已经是比例，前端不需要再自己除以某个写死的容量
  ban_table_usage: f64
  # 最近 5 分钟内落进历史库 ban_events 的封禁数（与 today_bans 同一个缓存、同一个半开
  # 区间口径）
  recent_bans: u64
  # 基线更新是否被冻结（异常值污染防护：短期速率超过有效基线×3 时停止更新基线 5 分钟，
  # 免得一次突发把基线抬上去、随后所有读数都显得正常）。与峰值时段无关
  baseline_frozen: bool
  # 当前是否落在峰值时段（9-18 点 UTC）：它同时决定 EWMA 基线是否上调 1.5 倍，两处共用
  # 同一个判据函数，不各留一份副本
  peak_hours: bool
}

# ---- 封禁 -------------------------------------------------------------------

type BanResponse {
  ip: String
  jail: String
  banned_at: i64
  remaining_seconds: i64
  reason: String
  ban_count: u32
  is_permanent: bool
}

type BanDetailResponse {
  ip: String
  is_banned: bool
  jail_name: String
  reason: String
  banned_at: i64
  expires_at: i64
  is_permanent: bool
  fail_count: u32
  ban_count: u32
  last_unbanned_at: i64
  was_permanent: bool
  progressive_level: String
  next_ban_duration: String
  reputation_score: u32
  reputation_multiplier: f64
}

type BanOperationResponse {
  ip: String
  action: String
  permanent: bool
  duration_seconds: Option<u64>
}

type BatchOperationResponse {
  total: u64
  succeeded: u64
  failed_count: u64
  details: Vec<String>
}

request CreateBanRequest {
  ip: String
  duration: Option<u64>
  reason: Option<String>
}

# 批量封禁的请求体。`duration` 缺省即契约的 3600 秒（见 defect
# HTTP_BATCH_BAN_BECOMES_PERMANENT：这里**没有**「缺省 = 永久」的读法，永久封禁只能由
# 单条 POST /api/v1/bans 的 duration 缺省/0 产生）。`ips` 是 1..100 条，越界 40005。
request BatchBanRequest {
  ips: Vec<String>
  duration: Option<u64>
  reason: Option<String>
}

# ---- Jail -------------------------------------------------------------------

# 一个 jail 的配置 + 运行时读数。契约里 jail 只在 /api/v1/jails 这一层暴露（没有
# /api/v1/jails/{name}），逐 jail 的计数因此都并进这里。
#
# 三组数的**原点不同**，面板不能把它们排成一列就当同类读：
#   - max_retries / findtime / ban_time 是配置值，随热重载变；
#   - ban_count 是当前活跃封禁数（内存镜像，与 /api/v1/stats 的 current_bans 同源），
#     不是历史累计——历史累计在 ban_events 里，由 /stats/ban-effectiveness 回答；
#   - lines_parsed … bans_triggered 是本进程解析日志以来的累计计数，**重启归零**。
type JailResponse {
  name: String
  enabled: bool
  # 该 jail 当前的活跃封禁数（内存镜像按 jail 的反向索引；不是历史累计）
  ban_count: usize
  # 配置的失败阈值（原始值，未乘任何系数）
  max_retries: u32
  # 此刻该 jail 对外部新地址实际生效的阈值 = ceil(max_retries × 高峰期系数)。
  # 内网系数与信誉系数都**按来源地址**生效，不属于 jail，因此不乘在这里（乘了就变成
  # 「该 jail 对所有地址的阈值」，而那个数不存在）；读侧要自己那档就乘下面两个系数。
  effective_max_retries: u32
  findtime: u32
  # 基础封禁时长（秒）；**负值表示配置级永久封禁**，与 0 不同义
  ban_time: i32
  # 本次读取时刻（UTC 小时）是否落在业务高峰 9–18 点
  is_peak_hours: bool
  # 判定层的高峰期阈值系数（常量，非配置项）
  peak_hours_multiplier: f64
  # 判定层的内网来源阈值系数（常量，非配置项；按来源地址生效）
  internal_ip_multiplier: f64
  # 以下五项是本进程累计计数，重启归零；该 jail 尚无读数时逐项 0
  lines_parsed: u64
  regex_matches: u64
  ips_extracted: u64
  # 失败尝试计数。Go 面按 jail 的正则命中计（提取到一个地址即一次失败），因此它与
  # ips_extracted 同源同值；没有独立的「认证失败」事件流可读（见 defect HTTP_FAILURE_HISTORY_NOT_PERSISTED）
  failed_attempts: u64
  bans_triggered: u64
}

request UpdateJailRequest {
  enabled: bool
}

# ---- 配置 -------------------------------------------------------------------

type WebuiConfigResponse {
  sse_push_interval: u32
  rate_warning_pps: u64
  rate_critical_pps: u64
  rate_warning_syn: u64
  rate_critical_syn: u64
  max_syn_per_second: u32
  max_udp_per_second: u32
  max_icmp_per_second: u32
  max_ack_per_second: u32
  max_rst_per_second: u32
  max_fin_per_second: u32
  static_threshold: bool
  dynamic_threshold: bool
  ddos_detection: bool
  max_ban_entries: u32
  max_whitelist_entries: u32
  max_rate_entries: u32
  max_local_ip_cache: u32
  clear_logs_at: Option<String>
}

request UpdateConfigRequest {
  sse_push_interval: Option<u32>
  rate_warning_pps: Option<u64>
  rate_critical_pps: Option<u64>
  rate_warning_syn: Option<u64>
  rate_critical_syn: Option<u64>
  max_syn_per_second: Option<u32>
  max_udp_per_second: Option<u32>
  max_icmp_per_second: Option<u32>
  max_ack_per_second: Option<u32>
  max_rst_per_second: Option<u32>
  max_fin_per_second: Option<u32>
  static_threshold: Option<bool>
  dynamic_threshold: Option<bool>
  ddos_detection: Option<bool>
  max_ban_entries: Option<u32>
  max_whitelist_entries: Option<u32>
  max_rate_entries: Option<u32>
  max_local_ip_cache: Option<u32>
  clear_logs_at: Option<String>
}

# ---- 白名单 -----------------------------------------------------------------

# daemon 侧叫 WhitelistEntryResponse，前端 interface 叫 WhitelistEntry —— 同一
# 条数据在不同层用了两个名字。契约在这里显式记录，避免下次核对时又把它们当成
# 两个不同的类型。
type WhitelistEntryResponse {
  ts_name = "WhitelistEntry"
  cidr: String
  device: String
}

type WhitelistOperationResponse {
  cidr: String
  action: String
}

# 一条加白建议。样本来自 ban_history，按网段聚合：IPv4 取 /24、IPv6 取 /48，聚合前先把
# 地址掩到前缀边界（与白名单键的归一化同一条规则，见 defect HTTP_WHITELIST_KEY_DIVERGENCE）。
#
# min_bans 被用了**两次**，两道筛子都过才出场：先按地址筛（ban_history.ban_count ≥ min_bans
# 的行才进聚合，一次最多取 10000 行），再按网段合计筛（段内累计封禁次数 ≥ min_bans）。
# 因此「段内只有一台机器被封 40 次」会出现（地址级 40≥5、段级 40≥5），而「20 台各被封
# 4 次」整段不会出现（地址级全被筛掉，压根进不了聚合）。
type WhitelistRecommendation {
  # 推荐类型枚举。当前实现只聚合并只产出 "subnet"；单地址没有推荐路径，因此不会给 "ip"
  # （前端要按枚举渲染标签时，未知取值要落回原文而不是崩）
  rec_type: String
  # 已掩到前缀边界的网段（如 203.0.113.0/24）
  cidr: String
  reason: String
  # 该网段里被封禁过的**唯一地址数**。与 total_bans 分开才有信息量：一个 /24 被封 40 次
  # 可能是 1 台机器抽风，也可能是 20 台正常用户被误伤
  affected_ips: u32
  # 该网段内这些地址的累计封禁次数
  total_bans: u32
  # 证据强度 **百分数 0-100**，只按样本量分档：≥50→90、≥20→70、≥10→50、其余 30。
  # 阶梯与 /stats/threshold-recommendations 的 confidence 同一套刻度（两处都在回答
  # 「这条建议底下垫了多少件事」，各用一套刻度会让 70 在两处含义不同）
  confidence: u8
}

request CreateWhitelistRequest {
  cidr: String
}

# ---- 速率 -------------------------------------------------------------------

type RateResponse {
  ip: String
  packets_per_sec: u64
  bytes_per_sec: u64
  syn_packets_per_sec: u64
  udp_packets_per_sec: u64
  icmp_packets_per_sec: u64
  ack_packets_per_sec: u64
  rst_packets_per_sec: u64
  fin_packets_per_sec: u64
}

type RateHistoryResponse {
  timestamp: u64
  total_pps: u64
  total_bps: u64
  tracked_ips: u32
}

type RateWindowSnapshot {
  pps_short: u64
  pps_mid: u64
  pps_long: u64
  bps_short: u64
  bps_mid: u64
  bps_long: u64
}

# ---- 分析：复发与攻击者 -----------------------------------------------------

# 复发统计。**前四项出自 ban_events（封禁底账），permanent_bans 出自 ban_history**——
# 两个表回答的是两个问题：底账说「历史上被封过几次」，ban_history 说「现在还是不是永久」。
type RecidivismResponse {
  # 底账里出现过的不同地址数
  total_ips: u64
  # 其中 ban_count > 1（被封过至少两次）的地址数
  recidivist_ips: u64
  # recidivist_ips / total_ips 的**百分数 0-100**（不是 0-1 比例，见 defect HTTP_RECIDIVISM_RATE_UNIT）
  recidivism_rate: f64
  # ban_history 里**当前**标记为永久的地址数（与上面三项不同源，不是「底账里有过永久封禁的地址数」）
  permanent_bans: u64
  # 复发次数最高的前 10 个地址（服务端固定取 10，不接受 limit 参数；按 ban_count 降序、
  # 同数按最近封禁时间降序）
  top_recidivists: Vec<RecidivistEntry>
}

type RecidivistEntry {
  ip: String
  # 该地址的最大 ban_count（= 到过最高的那一级，不是事件条数）
  ban_count: u32
  # 该地址最近一次封禁时刻
  last_banned_at: i64
  # 该地址的事件里**有过**永久封禁（按底账 MAX(is_permanent) 读，不代表它此刻仍是永久——
  # 永久封禁可被人工解封，「此刻」在 ban_history 与 /api/v1/bans 里）
  was_permanent: bool
}

# 渐进式封禁各级的成效（把 ban_events 的「地址 × 封禁等级」底账折叠成一条漏斗）。
#
# 判据是一条**漏斗**：以每个地址到过的最高级（ban_events.ban_count 的最大值）为轴，
# 到达第 L 级 = max ≥ L，第 L 级的复发 = max ≥ L+1（又升了一级）。因此各层的 total_ips
# 单调不增，第 1 层的 total_ips 等于 total_unique_ips。
type BanEffectivenessResponse {
  # 恒为 4 层（level 1..4），无样本的层也在场并给出 total_ips=0——面板需要能区分
  # 「这一级没人到达」与「这一级很有效」
  levels: Vec<BanLevelEffectiveness>
  # 封禁底账里出现过的不同地址数
  total_unique_ips: u32
  # 到过第 2 级及以上的地址占总地址数的**百分数 0-100**（口径同 /stats/recidivism 的
  # recidivism_rate，见 defect HTTP_RECIDIVISM_RATE_UNIT 的 resolution）
  overall_recidivism_rate: f64
  # 一句话结论。历史库缺失或查不动时这里写清是「没有底账」还是「查询失败」，
  # levels 同时为空数组——该路由不编业务码，降级在 200 信封内完成
  summary: String
}

type BanLevelEffectiveness {
  # 等级序号 1..4，与 decision.ProgressiveDuration 的分档一一对应
  level: u8
  # 服务端给出的档位文案（含时长），前端直接显示：改分档时两边一起改才有对齐点
  label: String
  # 到达过这一级的不同地址数（分母）
  total_ips: u32
  # 其中又升到下一级的地址数。第 4 级是开口桶，这里的含义是「到顶格（永久）之后还被封过
  # 一次」的地址数（永久封禁可被人工解封，解封后再犯是这一级唯一的复发信号，不置 0）
  recidivist_ips: u32
  # recidivist_ips / total_ips 的**百分数 0-100**；total_ips 为 0 时取 0
  recidivism_rate: f64
  # 这一级里以永久封禁落账的事件对应的地址数（按**该级本身**是否永久计，不是「至今是否永久」）
  permanent_bans: u32
  # 结论文本，与前端 RecidivismPanel 的 describeRate 同刻度（≥30 偏高、≥10 可接受、其余很低），
  # total_ips=0 时为「无样本」，第 4 级单列顶格措辞
  verdict: String
}

# 等间隔复现的扫描源。样本来自 ban_events（最多读最近 10000 条），至少 3 次封禁才参与计算。
type PeriodicAttacker {
  ip: String
  # 参与计算的封禁次数（= timestamps 的长度，不是 ban_events.ban_count 的最大值）
  ban_count: u32
  avg_interval_secs: f64
  # 间隔的标准差（秒），与 jitter_rate（= stddev/avg，变异系数）同源两读
  interval_stddev: f64
  # 规则度 **百分数 0-100**：变异系数 <0.3 时取 (1-cv)×100，否则记 **0**——
  # 「没有可外推的周期」不写成一个低分，低分会被读成「有点周期」
  periodicity_score: u8
  # 该地址**最近一次**封禁所属的 jail（同一地址换 jail 时以最近那条为准）
  jail_name: String
  # 参与计算的全部封禁时刻（升序，Unix 秒）：均值之外还要给证据本身，
  # 面板要能画「第 n 次落在哪一天」
  timestamps: Vec<i64>
}

# 同一时间窗内多源联动。判据是**窗口内不同地址数**达到门槛（默认 ≥3 个），
# 不是事件条数——三个地址各来一次与一个地址来三次，后者不构成联动。
# 每个 jail 只报**第一个**达标的窗口（同一批攻击在滑窗里会命中几十个起点，全列出来
# 等于把一次事件复制成一排，还会把别的 jail 挤出载荷）。
type CollaborativeAttack {
  jail_name: String
  window_start: i64
  window_end: i64
  # 窗口内的不同地址总数。**可以大于 ips 的长度**：那一栏只列前 10 个（防单窗口把载荷撑爆），
  # 计数不带这个上限
  ip_count: u32
  # 窗口内的参与地址（升序，最多 10 个）
  ips: Vec<String>
  # 窗口内的封禁事件数（可大于 ip_count：同一地址在窗口内被封多次）
  total_bans: u32
  # 联动强度 **百分数 0-100** = min(100, 窗口内事件数/10×100)（按事件数放大，不按地址数）
  correlation_score: u8
}

# 一次封禁后的再犯周期外推。中位周期来自 ban_events 的封禁间隔。
type AttackPrediction {
  ip: String
  # 参与计算的封禁次数（≥3 才给出估计）
  ban_count: u32
  # 该地址**最近一次**封禁所属的 jail
  jail_name: String
  last_ban_at: i64
  median_interval_secs: f64
  predicted_next_attack: i64
  # predicted_next_attack − 本次读取时刻（可为负：估计时刻已过，随时可能再来）
  remaining_secs: i64
  # 置信度 **百分数 0-100** = 规则度×0.6 + 样本量×0.4（样本量按每 5 次封禁 100 分封顶）
  confidence: u8
  # 紧迫度枚举：imminent（<1 小时）/ soon（<6）/ later（<24）/ distant（≥24）
  urgency: String
}

type AttackPredictionSummary {
  # 按 predicted_next_attack 升序、同刻按 ip 升序，长度受 limit（默认 15，上限 100）截断
  predictions: Vec<AttackPrediction>
  jail_trends: Vec<JailAttackTrend>
  # 以下两项计的是**本载荷里**那几条（截断之后计数），所以恒不超过 predictions 的长度
  imminent_count: u32
  within_24h_count: u32
}

type JailAttackTrend {
  jail_name: String
  bans_24h: u32
  bans_7d: u32
  # 趋势枚举：rising / falling / stable（按近 24h 与前一日的量比较；无样本记 stable）
  trend: String
  # 该 jail 24 小时内预计再动手的**地址数**，按全集统计（不受 predictions 的 limit 截断）
  predicted_attackers_24h: u32
}

# 失败阈值调整建议。窗口是**近 7 天**的 ban_events，样本门槛：该 jail 在这 7 天里
# 至少 10 条封禁事件才出场。
#
# 复发的口径是**按地址、在本 jail 内**：一个地址在这 7 天里被**本 jail**封 ≥2 次才算复发。
# 不拿 ban_events.ban_count>1 判定——那个数是跨 jail 的全局累计次数，「被 sshd 封过一次
# 这次被 mysql 封」会被记进 mysql 的复发，而这一栏要回答的是「这个 jail 拦得住吗」。
#
# 只有**配置里现存的 jail** 会出现：事件里的 jail 名可能来自已删除的 jail，也可能来自
# POST /api/v1/bans 那条手工路径（固定写 "api"，它不是个有阈值可调的 jail）。对这些名字
# 谈「把阈值从几改到几」没有落点，而分析层对查不到的 jail 会给一个兜底默认值（5），
# 那个数在载荷里长得和真读数一样，所以读侧滤掉。
type ThresholdRecommendation {
  jail_name: String
  # 该 jail **当前配置**的 max_retries（每次读取现取，热重载后即变；不是启动快照）
  current_threshold: u32
  # 推荐值。direction=maintain 时它**等于 current_threshold**——「要不要改」由 direction
  # 这一栏表达，不用 0 当哨兵（载荷里 0 会被读成一个真实的阈值；
  # 见 defect HTTP_THRESHOLD_RECOMMENDATION_ZERO_AMBIGUOUS 的 resolution）
  recommended_threshold: u32
  # 调整方向枚举：decrease（复发率 >30%，取 current×0.7、下限 1）/ increase
  # （复发率 <10% 且事件 >20 条，取 current×1.5）/ maintain
  direction: String
  # 该 jail 近 7 天的封禁事件数
  total_bans: u32
  # 近 7 天在本 jail 出现过的不同地址数
  unique_ips: u32
  # 其中被封 ≥2 次的地址数（本 jail 内）
  recidivist_ips: u32
  # recidivist_ips / unique_ips 的**百分数 0-100**（与 /stats/recidivism 同口径）
  recidivism_rate: f64
  avg_bans_per_ip: f64
  reason: String
  # 证据强度 **百分数 0-100**，只看样本量：≥50→90、≥20→70、≥10→50、其余 30。
  # 与 /whitelist/recommendations 的 confidence 同一套阶梯
  confidence: u8
}

type ThresholdRecommendationResponse {
  recommendations: Vec<ThresholdRecommendation>
  # 一句话结论：出场 jail 数与其中建议调整的条数（按复发率降序排列）
  summary: String
}

# 封禁时长调整建议。窗口是**整份底账**（最近 10000 条 ban_events，不截 7 天）——
# 回归间隔是个慢变量，把它截进 7 天会让低频 jail 永远凑不出中位数。
# 只统计被封 ≥2 次的地址（一次没有「回归间隔」可言），因此 recidivist_count=0 的 jail 不出场。
type BanDurationRecommendation {
  jail_name: String
  # 该 jail **当前配置**的 ban_time（秒）。配置级永久（负值）的 jail **不出现在本载荷里**：
  # 它没有「时长」可调，硬套进算式会得到 current=-1 / recommended=0 这种在两处都读成
  # 「立刻过期」的形状。0 按 3600 兜底（现网配置不会出现 0，见 config 的 smart default）
  current_ban_time: i32
  # 该 jail 内被封 ≥2 次的地址数（排序键，降序）
  recidivist_count: u32
  # 这些地址相邻两次封禁间隔的**中位数**（秒）
  median_return_secs: u64
  # 推荐时长：中位数超过当前时长时取 max(中位数×1.5, 当前×2)，否则等于 current_ban_time
  recommended_ban_time: u64
  reason: String
  # 是否建议调整 = 「当前时长是否已足够」的取反（同一件事的两面，不另设判据）
  needs_adjustment: bool
}

type BanDurationRecommendationResponse {
  recommendations: Vec<BanDurationRecommendation>
  summary: String
}

# 低信誉地址清单。阈值固定 80：那是判定层信誉系数的第一档分界（80 分以下才开始收紧阈值），
# 所以「需要看一眼的名单」与判定层实际改行为的分界同源。
type ReputationEntryResponse {
  ip: String
  # 信誉分 0-100：初值 100，失败与封禁各按 persist 的扣分常量递减并钳到 0
  score: u32
  # 最近一次失败时刻；该地址从未记过失败时为 0（不是 null——这一栏在载荷里恒为整数）
  last_failure_at: i64
  # 累计失败次数。**自本列上线起累计**：迁移只补列不补史，旧行的计数从 0 开始
  total_failures: u32
  # 累计封禁次数。同上，自本列上线起累计（与 ban_events 的底账计数不是同一份）
  total_bans: u32
  # 该分数当前让阈值放宽的系数，直接取判定层的 ReputationMultiplier（≥80→1.0、≥50→0.8、
  # 其余 0.5），不在 HTTP 面重抄分段：面板显示的系数与实际生效的阈值必须出自同一份算式
  threshold_multiplier: f64
}

# ---- 分析：内核统计分布 -----------------------------------------------------

type UdpPortDistributionResponse {
  ports: Vec<UdpPortEntry>
  total_entries: usize
  max_entries: usize
}

type UdpPortEntry {
  port: u16
  packets: u64
  bytes: u64
  last_seen_secs: u64
}

type IcmpTypeDistributionResponse {
  types: Vec<IcmpTypeEntry>
  total_entries: usize
  max_entries: usize
}

type IcmpTypeEntry {
  type: u8
  code: u8
  packets: u64
  bytes: u64
  last_seen_secs: u64
}

type PacketSizeDistributionResponse {
  labels: Vec<String>
  counts: Vec<u64>
  total: u64
  # 每个桶占总数的**百分数 0-100**；total 为 0 时逐项 0（不是 NaN，NaN 会让整个响应编不出 JSON）
  percentages: Vec<f64>
}

type TtlDistributionResponse {
  labels: Vec<String>
  counts: Vec<u64>
  total: u64
  # 同 PacketSizeDistributionResponse.percentages：百分数 0-100，total 为 0 时逐项 0
  percentages: Vec<f64>
}

# 封禁时长分布。**形状恒定**：labels 与 counts 一一对应、长度恒为 6，没有读数时各项为 0
# （面板因此不需要处理「桶数会变」）。
#
# 桶边界（秒，左闭右开）取自判定层的渐进式封禁档位：
#   "≤5 分钟" [0,300) / "5–30 分钟" [300,1800) / "30 分钟–2 小时" [1800,7200) /
#   "2–24 小时" [7200,86400) / ">24 小时" [86400,∞) / "永久"
# 最后一格读 ban_events.is_permanent，不读时长（永久封禁没有时长）。
type BanDurationHistogramResponse {
  # 恒为上面 6 个标签，顺序固定
  labels: Vec<String>
  # 与 labels 同长的计数
  counts: Vec<u64>
  # **有可读时长或为永久**的事件数：迁移前写的旧行没有 duration_secs（NULL），
  # 「封了多久」已无从追究，它们不进任何桶、也不计入 total——把它们画进「≤5 分钟」
  # 会凭空造出一批柱子
  total: u64
}

type IpFragmentStatsResponse {
  # 所有被记账的 IP 包（内核逐包累加，不只是分片）
  total_packets: u64
  fragment_packets: u64
  # 分片包占全部流量的**百分数 0-100**（不是 0-1 比例）；total_packets 为 0 时取 0
  fragment_ratio: f64
}

type PortScanResponse {
  threshold: u32
  total_detected: u32
  scanners: Vec<PortScannerEntry>
}

type PortScannerEntry {
  ip: String
  unique_ports: u32
  packets: u64
}

type ServiceProbeResponse {
  threshold: u32
  # 与 PortScanResponse.total_detected **同名不同量**（缺陷 HTTP_SERVICE_PROBE_NO_TOTAL
  # 按此形状闭合，口径差异由 HTTP_SCANNER_TOTAL_COUNT_ASYMMETRY 跟踪）：这一侧是本次快照
  # 打包带出的行数（最多 20），那一侧是内核的累计检出事件计数。前端两处共用「检出 N 个」
  # 文案时要知道 port-scanners 的 N 会大于列表行数
  total_detected: u32
  probes: Vec<ServiceProbeEntry>
}

type ServiceProbeEntry {
  ip: String
  protocol_count: u32
  packets: u64
}

# 同网段的封禁聚合。窗口是**近 7 天**的 ban_events（最多读最近 10000 条），
# 段边界 IPv4 取 /24、IPv6 取 /48。按 total_bans 降序、同数按 subnet 升序，长度受
# limit（默认 50、上限 100）截断；载荷只有这一层，段内地址清单不外露。
type NetworkBlock {
  # 网段（已掩到段边界，如 203.0.113.0/24）
  subnet: String
  unique_ips: u32
  # 段内地址在窗口内的封禁事件总数（可大于 unique_ips）
  total_bans: u32
  last_banned_at: i64
  # 段内被封次数最多的地址；同次数时取地址文本较小者（不写这条 tie-break，
  # 每次刷新都可能换一个代表地址，map 的遍历顺序是随机的）
  top_ip: String
}

# ---- 热力图与日志 -----------------------------------------------------------

type HourlyHeatmap {
  hours: [HourlyBucket; 24]
}

type HourlyBucket {
  hour: u32
  bans: u64
  failed_attempts: u64
  ddos_events: u64
}

type LogPageResponse {
  items: Vec<LogEntry>
  total_lines: u64
  page: u32
  page_size: u32
  total_pages: u32
}

type LogEntry {
  line_number: u64
  content: String
}

request LogQueryParams {
  page: Option<u32>
  page_size: Option<u32>
  level: Option<String>
  keyword: Option<String>
  since: Option<String>
}

# ---- 分页参数（请求）--------------------------------------------------------

request PaginationParams {
  page: Option<u32>
  page_size: Option<u32>
  sort_by: Option<String>
}

# ---- SSE 连接诊断（两条流各自一份）------------------------------------------

type SseStreamStatus {
  current_connections: usize
  max_connections: usize
  limit_reached: bool
}

# 两条流各自一份状态：上限独立（events 10 / logs 5），`limit_reached` 由**所属流**
# 的上限判定。此前是一条扁平载荷、用 events 的上限推断日志流（缺陷
# HTTP_SSE_STATUS_INCOMPLETE）。
type SseStatusResponse {
  events: SseStreamStatus
  logs: SseStreamStatus
}
