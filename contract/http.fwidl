# 守护进程 HTTP 接口契约 —— daemon ↔ 前端 的单一真相源
#
# 三份契约的分工：netlink.fwidl 管**字节布局**（内核↔daemon），procfs.fwidl 管
# **命令文法**（内核↔运维），本文件管**路由表 + JSON 形状 + 错误模型**
# （daemon↔前端）。
#
# 为什么需要这份契约
# ------------------
# 1. 同一个字段被写了两遍：daemon 的 Rust struct 与前端 types.ts。两边靠人工
#    同步，此前已出现 recidivism_rate 同名不同单位（百分数 0–100 vs 比例 0–1）
#    这类只在运行期才暴露的偏差。
# 2. 错误不是单一形状：信封 / 纯文本 / axum 提取器默认三套并存，且 HTTP 状态
#    码与信封内 code 是两套编号。前端若只按一套处理，就会出现「登录错密码时
#    按钮永久转圈」这类问题（见 auth 段对 WWW-Authenticate 的说明）。
# 3. 两条 SSE 流各自有独立的连接上限（10 / 5），而诊断端点只反映其中一条，
#    前端据此判断「是否达到上限」会误判。
#
# 本文件的写法
# ------------
# - `route` 的 `auth` 必须与 handler.rs 里该路由落在哪个 Router 组一致：
#   `none` = public_routes（无认证），`required` = protected_routes（经中间件）。
# - `status` 是成功路径的 HTTP 状态码，必须能在 handler 里读到。
# - `codes` 是**信封内的业务码**，不是 HTTP 状态码；每个码都要在 handler.rs
#   里有 `::error(<码>` 调用点。
# - 字段名一律写**线上 JSON 的 key**（不是 Rust 字段名）。因此对 `r#type`
#   这类 raw identifier，这里写 `type`。
#
# 与实现核对
# ----------
# verify_http.py 会到 handler.rs / auth.rs / sse.rs / web_ui/*.rs 与前端
# types.ts / endpoints.ts 逐项核对：路由、认证、SSE 上限与事件、信封、
# 业务码、错误形状、安全头、以及**跨层字段**（同一个字段必须同时存在于
# Rust 结构体与 TS interface）。任何一处对不上都是门禁失败。

httpproto firewall_daemon_http

namespace Http

# API 前缀（所有 RESTful 端点都在其下）
base "/api/v1"

# ============================================================================
# 统一信封
# ============================================================================
#
# 成功：code = 0，message = ""（空串，不是 "ok"）。
# 失败：code = 业务码，data 为 null（Rust 侧是 ()，序列化成 null）。
#
# 注意：**没有**任何 `skip_serializing_if`。成功响应里 data 一定存在，
# 失败响应里 data 一定存在且为 null，message 一定存在。前端不需要判 undefined。

envelope {
  code: i32
  data: T
  message: String
}

# ============================================================================
# 认证
# ============================================================================
#
# Basic Auth，凭据来自配置的 metrics_username / metrics_password。
# 两项**都为空**才视为「未配置认证」并放行；半配置（只给一项）一律判失败，
# 以免一个配置笔误让整个 API 开放。
#
# 连续失败达到阈值后锁定一段时间，期间一律拒绝（含正确凭据）——这是刻意的
# 暴力破解防护，代价是运维在锁定期内无法登录。
#
# 前端登录页对应行为：凭据填错超过阈值后，正确的凭据也会被拒，直到锁定窗口
# 过去。UI 必须把这一点说清楚，否则用户会以为密码不对而反复重试、不断续锁。

auth {
  scheme = "Basic"
  token_query = "access_token"
  failure_threshold = 10
  lockout_seconds = 60
  # 401 的 HTTP 状态码（信封里没有对应业务码——认证失败走的是纯文本形状）
  unauthorized_status = 401
}

# ============================================================================
# 错误形状
# ============================================================================
#
# 三种形状并存是**实现现状**，不是设计选择。重写时应收敛为一种；在此之前
# 前端必须三种都能处理。

errmodel AUTH_UNAUTHORIZED {
  shape = text
  where = "src/daemon/http_exporter/auth.rs:401 Unauthorized"
  statuses = 401
  body = "401 Unauthorized\n"
  note = "有意不发 WWW-Authenticate：该头会让浏览器弹原生凭据对话框，且对话框期间 fetch 一直挂起拿不到响应，表现为『输错密码按钮永久转圈』。本项目用应用内登录表单，凭据由前端显式携带。严格 HTTP 语义下 401 应带该头，此处为可用性刻意偏离。"
}

errmodel STATIC_NOT_FOUND {
  shape = text
  where = "src/daemon/http_exporter/handler.rs:404 Not Found"
  statuses = 404
  body = "404 Not Found\n"
  note = "静态资源与 sw.js 未命中时的纯文本 404（无认证路由组，不经信封）"
}

errmodel AXUM_EXTRACTOR_DEFAULT {
  shape = axum_default
  where = "src/daemon/api/routes/bans.rs:Json(req): Json<"
  statuses = 422, 400, 415, 404, 405
  note = "axum 提取器默认错误：Json 反序列化失败 422、Query 解析失败 400、Content-Type 不符 415、方法不匹配 405、路径不匹配 404。响应体是 axum 的纯文本，不是信封 —— 前端不能假设所有错误都能 JSON.parse。"
}

# ============================================================================
# 安全头（中间件对**所有**路由统一施加）
# ============================================================================

header "X-Content-Type-Options" {
  scope = all
  value = "nosniff"
}

header "X-Frame-Options" {
  scope = all
  value = "DENY"
}

header "Content-Security-Policy" {
  scope = all
  value = "default-src 'none'"
  value_webui = "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data:; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com"
}

header "Cache-Control" {
  scope = all
  value = "no-store"
}

# ============================================================================
# 业务码（信封内的 code 字段）
# ============================================================================
#
# 与 HTTP 状态码是两套编号：HTTP 状态码表达「请求是否被处理」，业务码表达
# 「为什么失败」。同一个业务码在不同路由上可能配不同的 HTTP 状态码
# （如 40004 在 PUT /config 与 DELETE /whitelist/:cidr 上都是 400，
# 而在别处是别的语义）。

code 0 {
  status = 200
  text = "成功；message 为空串"
}

code 40001 {
  status = 400
  text = "封禁失败（内核未确认、IP 非法、或内核返回错误）"
}

code 40002 {
  status = 400
  text = "解封失败（IP 非法或内核拒绝）"
}

code 40003 {
  status = 400
  text = "批量解封临时封禁失败 / 添加白名单失败"
}

code 40004 {
  status = 400
  text = "更新配置失败 / 移除白名单失败"
}

code 40005 {
  status = 400
  text = "批量封禁参数非法（列表为空或超过 100 条）/ 日志查询参数非法"
}

code 40006 {
  status = 400
  text = "封禁详情查询失败（IP 非法）"
}

code 404 {
  status = 404
  text = "Jail 不存在"
}

code 50002 {
  status = 500
  text = "服务端内部错误（历史库查询任务 join 失败等），message 含具体原因"
}

# ============================================================================
# 已核实缺陷：重写必须修复，或在本文件中显式改写为「有意保留」
# ============================================================================

defect HTTP_BANS_DUAL_SHAPE {
  severity = high
  status = fixed
  fix = "src/daemon/api/routes/bans.rs:pub async fn handle_api_bans"
  where = "src/daemon/http_exporter/handler.rs:if params.page.is_some()"
  resolution = "统一为单一形状：GET /api/v1/bans 一律返回分页信封 PaginatedResponse<BanResponse>，不再有裸数组分支；前端随之删除重载签名与运行期分支。"
  text = "GET /api/v1/bans 有两种互不兼容的响应形状：不带 page/page_size 时返回裸数组，带了才返回分页信封。前端为此维护两个重载签名与运行期分支。它让『data 一定是对象』这一前提失效，任何通吃的错误处理都会踩空"
}

defect HTTP_SSE_STATUS_INCOMPLETE {
  severity = medium
  status = fixed
  fix = "src/daemon/api/payloads.rs:current_connections >= max_connections"
  where = "src/daemon/http_exporter/handler.rs:current >= max"
  resolution = "sse-status 载荷扩展为同时报告两条流：events 与 logs 各自的 current / max，前端按所属流的上限判断 limit_reached，不再用单一上限推断另一条流。"
  text = "/api/v1/stats/sse-status 只反映 /api/v1/events 的 10 连接上限，看不到 /api/v1/logs/stream 的独立 5 连接上限。前端用它判断『是否达到上限』会在日志流被拒时误判为未达上限，从而把 503 当成网络故障无限重连"
}

defect HTTP_RECIDIVISM_RATE_UNIT {
  severity = medium
  where = "src/daemon/web_ui/analysis.rs:recidivism_rate"
  resolution = "统一为百分数 0–100：ban-effectiveness 的各 level 一并改为百分数，前端对两处使用同一个格式化函数。"
  text = "recidivism_rate 同名不同单位：/api/v1/stats/recidivism 返回百分数（0–100），/api/v1/stats/ban-effectiveness 的各 level 返回比例（0–1）。前端若用同一个格式化函数渲染，会有一个高出 100 倍"
}

defect HTTP_TODAY_BANS_EQUALS_TOTAL {
  severity = low
  where = "src/daemon/web_ui/stats.rs:today_bans"
  resolution = "today_bans 改为真实「今日」窗口（本地时区自然日 00:00 起，按各封禁的 banned_at 计数），并在此契约中写明窗口定义与所用的时区。"
  text = "today_bans 与 total_bans 取的是同一个值，『今日』这一时间窗并未实现。仪表盘上两个数字永远相同"
}

defect HTTP_THRESHOLD_RECOMMENDATION_ZERO_AMBIGUOUS {
  severity = low
  where = "src/daemon/history_snapshot/threshold_analysis.rs:推荐阈值（0 = 无需调整）"
  resolution = "0 表示「无需调整」：维护分支改为返回 0（而非原阈值），前端据此显示「无需调整」；非 0 时始终是具体推荐阈值。"
  text = "ThresholdRecommendation.recommended_threshold 的注释称『0=无需调整』，但所有生成分支都不产生 0（最小也是原阈值）。前端按注释判断『无需调整』会永远不成立"
}

defect HTTP_SERVICE_PROBE_NO_TOTAL {
  severity = low
  where = "src/daemon/web_ui/packet_analysis.rs:ServiceProbeResponse"
  resolution = "ServiceProbeResponse 补 total_detected（与 PortScanResponse 形状对齐），前端两处共用同一套「检出 N 个」文案。"
  text = "ServiceProbeResponse 缺 total_detected，而同类的 PortScanResponse 有。前端在两个页面上无法用同一套『检出 N 个』文案"
}

defect HTTP_HEALTH_NOT_ENVELOPED {
  severity = low
  status = retained
  reason = "探针语义：/health 与 /healthz 以 HTTP 状态码承载就绪与否（200 = 就绪，503 = 未就绪），载荷是 RuntimeSnapshot 裸 JSON。这是全项目唯一一个『状态码即语义』的端点，套信封会把语义压回 200 + code 字段，反而让 k8s/负载均衡探针无法按状态码判定。契约中显式记为有意例外而非缺陷。"
  where = "src/daemon/api/routes/runtime.rs:pub async fn handle_health"
  resolution = "有意保留裸状态码（探针语义）：/health 与 /healthz 以 HTTP 状态码承载语义，在此契约中显式记为有意例外而非缺陷；前端保留 getRawJson 特判。"
  text = "/health 与 /healthz 不走信封，直接返回 RuntimeSnapshot；且未就绪时是 503 而非 5xx 信封。它是全项目唯一一个『HTTP 状态码即语义』的端点，前端必须特判（endpoints.ts 用 getRawJson）"
}

defect HTTP_LOG_SSE_LIMIT_DOC_DRIFT {
  severity = low
  status = fixed
  fix = "src/daemon/web_ui/log_viewer.rs:各自独立计数与上限"
  where = "src/daemon/web_ui/log_viewer.rs:共享限制"
  resolution = "修正注释与实现一致：两条流各自独立的上限（events 10 / logs 5），实现不变，只改误导性注释。"
  text = "日志流的上限注释说『与 Web UI SSE 共享 MAX_SSE_CONNECTIONS 限制』，但实现是两条互相独立的计数器：/api/v1/events 用 sse.rs 的 MAX_SSE_CONNECTIONS=10，日志流用本文件的 MAX_LOG_SSE_CONNECTIONS=5。两处注释（模块头第 8 行与常量上的文档注释）都与实现不符，容易误导排查——『events 才连了 3 个，日志流却被拒』不是 bug"
}

defect HTTP_BAN_SORT_DOC_INCOMPLETE {
  severity = low
  where = "src/daemon/web_ui/ban_ops.rs:排序字段（可选）"
  resolution = "文档补全为 7 个取值（banned_at_desc / banned_at_asc / ip_asc / ip_desc / remaining_asc / remaining_desc / jail_asc），与实现及前端联合类型一致。"
  text = "PaginationParams.sort_by 的文档注释只列了 4 个取值（banned_at_desc/banned_at_asc/ip_asc/jail_asc），实现另有 3 个（ip_desc/remaining_asc/remaining_desc），前端 BanSortKey 联合类型 7 个取值——与实现一致、唯独与注释不符。契约以实现与前端为准"
}

defect HTTP_READ_PATH_WRITES_STATE {
  severity = high
  status = fixed
  fix = "src/daemon/state/compose.rs:pub fn purge_expired_bans"
  where = "src/daemon/web_ui/ban_ops.rs:purge_expired(now)"
  resolution = "读路径只读：purge 移到 scheduler 的独立周期任务，由它独占调用；读侧改从 state 取不可变快照。落地方式：state/compose.rs 新增 purge_expired_bans（两侧都清，记账口径照搬），runtime/scheduler.rs 按 5 秒节拍调用，main.rs 装配 runtime::spawn_periodic；get_active_bans() 的限流 purge 与其节流静态量一并删除。"
  text = "get_active_bans() 在**读**路径上按 5 秒节流执行 purge_expired，顺带自增 DAEMON_STATS.total_unbans 并写入封禁时长统计。旧 SSE 每个 tick（默认 1 秒）都会读一次，于是「每秒被读一次的统计」被读路径自己改写——读数与写入者互相污染，仪表盘上的解除封禁计数不可复现。注：旧 SSE 引擎已退役（本缺陷的放大器已拆），throttled purge 也已从 get_active_bans 删除；清理改由组合根 scheduler 的周期任务驱动"
}

defect HTTP_SSE_RESERIALIZES_EVERY_DOMAIN {
  severity = medium
  status = fixed
  fix = "src/daemon/api/sse.rs:pub async fn drive_events_stream"
  where = "src/daemon/web_ui/sse.rs:let Ok(stats_json) = serde_json::to_string(&stats)"
  resolution = "按域序列化：连接持有上次发送的版本，只对真正变化的域调用渲染器。修复回执记在 api/sse.rs 的 DomainRenderer 与「只序列化变化域」的计数测试上（本缺陷在旧 SSE 引擎退役时随 where 一并消失）。"
  text = "旧 SSE 每个 tick 把 5 份载荷（stats/bans/jails/whitelist/rates）全量 serde_json::to_string 一遍，无论有没有变化，且这段序列化在**每条连接**的循环里各做一次。成本是「连接数 × 域数 × 每秒一次」：安静时段也在重复序列化同样的内容，payload 越大越明显"
}

defect HTTP_WHITELIST_KEY_DIVERGENCE {
  severity = medium
  status = open
  where = "src/daemon/ban/mod.rs:fn build_cidr_key"
  resolution = "键的规范化只有一处（state/cidr.rs 的 CidrKey）：网络地址（主机位清零）+ 恒带 /prefix（裸地址即 /32、/128）。修复回执记在 state/whitelist.rs 的 CidrKey 键类型与 cidr.rs 的规范化测试上（本缺陷在旧键规则退役时随 where 一并消失）。"
  text = "白名单的键有三套互不相同的规则：LIST 响应恒带 /prefix；事件路径对 /32·/128·/0 存裸地址；build_cidr_key 又把 IPv6 /0 归一成 /128。同一子网因此会拿到两个键，LIST 的整表覆盖打不中事件插入的那一条，表现为「白名单里看到两条同一个网段」或「删了还在」。三套规则分别位于 ban/mod.rs 的 build_cidr_key、netlink/handlers.rs 的 LIST 拼键与事件路径拼键；三处都是旧实现，随该模块退役一并消失"
}

# ============================================================================
# 路由表
# ============================================================================
#
# `returns` 取 type | text | bytes | stream：
#   type   经信封返回 JSON 载荷（data 的类型见同名 type/request 块）
#   text   不经信封，直接返回纯文本（静态资源未命中等）
#   bytes  二进制（sw.js 等静态文件）
#   stream 长连接 SSE（必须声明 max_connections 与 events）
#
# `status` 是**成功**路径的 HTTP 状态码；`alt_status` 是同一路由上另一个
# 「成功但语义不同」的状态码（如 201 Created 与 200 OK 并存）。失败状态码
# 由 codes 对应的业务码隐含（见 code 块）。

# ---- 无认证：健康检查 -------------------------------------------------------

route GET "/health" {
  auth = none
  handler = handle_health
  returns = type
  status = 200
  alt_status = 503
  note = "唯一『HTTP 状态码即语义』的端点：200 = status==\"ok\"，503 = 未就绪。载荷直接是 RuntimeSnapshot，不经信封（见 defect HTTP_HEALTH_NOT_ENVELOPED）。"
}

route GET "/healthz" {
  auth = none
  handler = handle_health
  returns = type
  status = 200
  alt_status = 503
  note = "与 /health 同函数，供 k8s/负载均衡探针使用"
}

# ---- 无认证：SPA 外壳与静态资源 ---------------------------------------------
#
# 这些路由返回的都是**不含运行时数据**的静态壳；所有数据一律经受保护的
# /api/v1/* 取用。因此公开不泄露状态，且浏览器直接打开页面、加载子资源都不
# 需要凭据（若放进认证组，配了凭据后页面反而打不开）。

route GET "/" {
  auth = none
  handler = handle_redirect
  returns = text
  status = 302
  note = "重定向到 /dashboard；**必须原样保留 query string**，否则 /?access_token=<token> 直达会丢凭据"
}

route GET "/dashboard" {
  auth = none
  handler = handle_dashboard
  returns = text
  status = 200
}

route GET "/bans" {
  auth = none
  handler = handle_spa_bans
  returns = text
  status = 200
}

route GET "/whitelist" {
  auth = none
  handler = handle_spa_whitelist
  returns = text
  status = 200
}

route GET "/jails" {
  auth = none
  handler = handle_spa_jails
  returns = text
  status = 200
}

route GET "/ddos" {
  auth = none
  handler = handle_spa_ddos
  returns = text
  status = 200
}

route GET "/logs" {
  auth = none
  handler = handle_spa_logs
  returns = text
  status = 200
}

route GET "/settings" {
  auth = none
  handler = handle_spa_settings
  returns = text
  status = 200
}

route GET "/static/*path" {
  auth = none
  handler = handle_static
  returns = bytes
  status = 200
  alt_status = 404
  note = "未命中时返回纯文本 \"404 Not Found\\n\"（errmodel STATIC_NOT_FOUND）"
}

route GET "/sw.js" {
  auth = none
  handler = handle_sw
  returns = bytes
  status = 200
  alt_status = 404
  note = "带 Service-Worker-Allowed: / 与 Cache-Control: no-cache；浏览器注册 SW 时不带交互式凭据，放进认证组会 401 导致注册失败"
}

# ---- 需认证：指标与 SSE -----------------------------------------------------

route GET "/metrics" {
  auth = required
  handler = handle_metrics
  returns = text
  status = 200
  note = "Prometheus 文本格式 text/plain; version=0.0.4; charset=utf-8"
}

route GET "/api/v1/events" {
  auth = required
  handler = handle_sse
  returns = stream
  status = 200
  alt_status = 503
  max_connections = 10
  events = connected, stats, bans, jails, whitelist, rates
  keepalive_secs = 15
  note = "超过 10 连接返回 503。keep-alive 事件文本为 \"keep-alive\"。"
}

route GET "/api/v1/logs/stream" {
  auth = required
  handler = handle_log_stream
  returns = stream
  status = 200
  alt_status = 503
  max_connections = 5
  events = connected, log, error
  keepalive_secs = 15
  note = "上限 5 与 /api/v1/events 的 10 **各自独立**；keep-alive 文本同为 \"keep-alive\"。"
}

