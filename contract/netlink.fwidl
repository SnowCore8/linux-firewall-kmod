# ============================================================================
# netlink.fwidl — 内核模块 ↔ 守护进程 netlink 线格式契约（单一真相源）
#
# 由 contract/gen.py 生成：
#   contract/generated/netlink_uapi.h        C 侧（内核模块 #include）
#   contract/generated/netlink_contract.rs   Rust 侧（daemon 引用 / 校验）
#   contract/generated/netlink.d.ts          TS 侧
#   contract/generated/netlink_layout.json   机器可读布局清单（三端校验用）
#
# 语法（gen.py 实现，不是通用 IDL）
#   namespace NAME
#   magic NAME = 0xHEX
#   enum NAME : WIDTH { MEMBER = VALUE }
#   bits NAME : WIDTH { MEMBER = BITPOS }
#   alias NAME = WIDTH[N]
#   struct NAME { TYPE FIELD }
#   message NAME { type = MsgType::X  TYPE FIELD ... }
#   message NAME = MsgType::X              # 仅消息头，无载荷
#   FIELD := NAME | str[N] NAME | TYPE[N] NAME | ITEM tail
#
# 线格式约定（gen.py 强制，不可逐字段覆写）
#   1. 所有结构体 packed：无隐式填充，与 C __packed / Rust #[repr(C, packed)] 一致
#   2. 所有多字节整数 BIG-ENDIAN：内核 cpu_to_be*，daemon to_be/from_be
#   3. 需要填充处必须写成显式 u8[N] 字段，以杜绝「靠对齐产生空隙」的隐式假设
#   4. addr 为裸字节：IPv4 占前 4 字节、余下 0；字符串为 NUL 结尾的定长字节数组
#
# 传输层：NETLINK_USERSOCK；控制面要求发送方持有 CAP_NET_ADMIN
# 长度上限：msg_len 为 u16（≤65535）。任何「定长部分 + 单次变长部分」都必须
#   落在该上限内，变长响应必须分页；gen.py 会在生成期断言并打印余量。
# ============================================================================

namespace Fw

# 消息魔数；不匹配的报文一律丢弃
magic FW_NL_MAGIC = 0x46574C4E

# 地址族；与 Linux AF_INET / AF_INET6 同值（不依赖内核宏，保证三端一致）
enum AddrFamily : u8 {
    INET  = 2    # IPv4
    INET6 = 10   # IPv6
}

# 封禁状态变更动作
enum BanAction : u8 {
    BAN   = 1
    UNBAN = 2
}

# 白名单状态变更动作
enum WhitelistAction : u8 {
    ADD    = 1
    REMOVE = 2
}

# netlink 消息类型；1-21 为历史值，22-23 为单守护进程互斥注册
enum MsgType : u16 {
    DDOS_EVENT              = 1    # 内核 → daemon：DDoS 违规事件
    BAN_IP                  = 2    # daemon → 内核：封禁 IP
    UNBAN_IP                = 3    # daemon → 内核：解封 IP
    SET_CONFIG              = 4    # daemon → 内核：配置更新
    BAN_STATE_CHANGE        = 5    # 内核 → daemon：封禁状态变更
    LIST_BANS_QUERY         = 6    # daemon → 内核：查询封禁列表
    LIST_BANS_RESPONSE      = 7    # 内核 → daemon：封禁列表响应
    STATS_QUERY             = 8    # daemon → 内核：查询统计
    STATS_RESPONSE          = 9    # 内核 → daemon：统计响应
    LIST_WHITELIST_QUERY    = 10   # daemon → 内核：查询白名单
    LIST_WHITELIST_RESPONSE = 11   # 内核 → daemon：白名单响应
    ADD_WHITELIST           = 12   # daemon → 内核：添加白名单
    REMOVE_WHITELIST        = 13   # daemon → 内核：移除白名单
    CONFIG_ACK              = 14   # 内核 → daemon：配置确认
    LIST_RATES_QUERY        = 15   # daemon → 内核：查询速率统计
    LIST_RATES_RESPONSE     = 16   # 内核 → daemon：速率统计响应
    WHITELIST_STATE_CHANGE  = 17   # 内核 → daemon：白名单状态变更
    CMD_RESULT              = 18   # 内核 → daemon：命令执行失败
    CONFIG_CHANGE           = 19   # 内核 → daemon：procfs 配置变更
    ANALYSIS_QUERY          = 20   # daemon → 内核：查询分析数据
    ANALYSIS_RESPONSE       = 21   # 内核 → daemon：分析数据响应
    DAEMON_REGISTER         = 22   # daemon → 内核：注册为唯一守护进程
    DAEMON_REGISTER_ACK     = 23   # 内核 → daemon：注册确认 / 拒绝
    SET_PROTECTED_PORTS     = 24   # daemon → 内核：受保护端口位图
}

# 配置项标志位；声明位序号，生成器左移
bits ConfigFlags : u32 {
    BAN_TIME          = 0
    RATE_WINDOW       = 1
    MAX_PPS           = 2
    MAX_BPS           = 3
    MAX_SYN           = 4
    MAX_UDP           = 5
    MAX_ICMP          = 6
    MAX_ACK           = 7
    MAX_RST           = 8
    MAX_FIN           = 9
    DYNAMIC_THRESHOLD = 10
    BASELINE_UPDATE   = 11
    DDOS_BAN_DURATION = 12
}

# 动态阈值子标志位
bits DynThresholdFlags : u32 {
    ENABLED = 0
}

# 地址缓冲：IPv4 用前 4 字节，IPv6 用全部 16 字节
alias addr16 = u8[16]

# ---------------------------------------------------------------------------
# 公共消息头（12 字节）
#
# packed 布局为 12 字节。gen.py 会给出 static_assert，以生成值为准。
#
# seq 是**请求/响应配对序列号**，语义如下（daemon 侧必须按此实现）：
#   - 请求：daemon 发起的每个请求（包括 DAEMON_REGISTER）用非 0 且当前在途
#     请求内唯一的 seq，内核在响应中原样回填。daemon 按 (msg_type, seq) 关联
#     到发起方。
#   - 推送：内核主动推送的事件（DdosEvent / BanStateChange /
#     WhitelistStateChange / CmdResult / ConfigAck 等）与 SET_CONFIG、
#     BAN_IP 等无需配对的指令，seq = 0，表示「不参与配对」。
#   - daemon 收到 seq = 0 的响应是协议违例；收到无法匹配在途请求的响应时
#     必须记入可观测计数并告警，不得静默丢弃——否则「响应丢失 / 内核未实现
#     某查询」会表现为无提示的功能失效。
# ---------------------------------------------------------------------------
struct MsgHdr {
    u32 magic      # 恒为 FW_NL_MAGIC
    u16 msg_type   # MsgType 取值
    u16 msg_len    # 含本头的总长度
    u32 seq        # 请求/响应配对序列号；0 = 不参与配对（推送/单向指令）
}

# ===========================================================================
# 内核 → daemon
# ===========================================================================

# DDoS 违规事件：命中速率或协议阈值时推送
message DdosEvent {
    type = MsgType::DDOS_EVENT
    u8        af        # AddrFamily
    str[32]   reason    # 违规原因（如 "SYN flood"）
    u32       rate_pps  # 触发时该 IP 的实测速率（包/秒）
    addr16    addr
}

# 封禁状态变更：procfs 手动操作或内核自动封禁时推送。
# 携带实时统计字段，使 daemon 无需轮询即可同步计数。
message BanStateChange {
    type = MsgType::BAN_STATE_CHANGE
    u8      action           # BanAction
    u8      af               # AddrFamily
    u8      prefix_len       # 前缀长度；32/128 = 精确单机
    u32     duration_secs    # 0 = 永久
    addr16  addr
    str[32] reason
    str[32] jail_name        # 空串表示由 daemon 推断
    u64     packets_dropped  # 累计丢弃包数
    u64     packets_accepted # 累计接受包数
    u32     current_bans
    u32     whitelist_count
}

# 白名单状态变更
message WhitelistStateChange {
    type = MsgType::WHITELIST_STATE_CHANGE
    u8      action          # WhitelistAction
    u8      af              # AddrFamily
    u8      prefix_len      # IPv4 由掩码换算；IPv6 直接使用
    addr16  addr
    str[16] device          # 空串表示不限定设备
    u32     whitelist_count
}

# 命令执行失败通知（仅失败时推送）
message CmdResult {
    type = MsgType::CMD_RESULT
    u16     original_cmd  # 触发失败的 MsgType 取值
    i16     pad           # 显式填充，维持后续字段偏移
    i32     error_code    # 负值错误码
    u8      af            # AddrFamily
    addr16  addr
}

# 配置更新确认
message ConfigAck {
    type = MsgType::CONFIG_ACK
    u32 applied_flags   # 实际生效的 ConfigFlags 位
    u32 rejected_flags  # 被拒绝的 ConfigFlags 位
}

# procfs 写入配置后的变更广播；载荷布局与 SetConfig 一致
message ConfigChange {
    type = MsgType::CONFIG_CHANGE
    u32  flags                        # ConfigFlags
    u32  ban_time                     # 秒
    u32  rate_window_seconds          # 秒
    u64  max_packets_per_second
    u64  max_bytes_per_second
    u64  max_syn_per_second
    u64  max_udp_per_second
    u64  max_icmp_per_second
    u64  max_ack_per_second
    u64  max_rst_per_second
    u64  max_fin_per_second
    u32  dynamic_threshold_flags      # DynThresholdFlags
    u32  dynamic_threshold_ratio_x100 # 倍数 × 100（定点）
    u64  baseline_pps
    u64  baseline_bps
    u32  ddos_ban_duration            # 秒
}

# ---------------------------------------------------------------------------
# 内核 → daemon：查询响应
# ---------------------------------------------------------------------------

# 封禁条目（ListBansResponse 的尾部元素）
struct BanEntry {
    u8      af
    u8      is_permanent   # 1 = 永久，0 = 到期自动解封
    u8      prefix_len     # 前缀长度；32/128 = 精确单机
    u32     duration_secs
    u64     banned_at      # Unix 秒
    addr16  addr
    str[32] jail_name
    str[32] reason
}

# 封禁列表响应；必须分页
message ListBansResponse {
    type = MsgType::LIST_BANS_RESPONSE
    u32       count    # 本页条目数
    u32       total    # 内核当前总条目数
    u32       offset   # 本页起始下标（IPv4 表序 + IPv6 表序）
    BanEntry  tail
}

# 统计响应（定长）
message StatsResponse {
    type = MsgType::STATS_RESPONSE
    u64 current_bans
    u64 total_bans
    u64 total_unbans
    u64 whitelist_count
    u64 packets_dropped
    u64 packets_accepted
}

# 白名单条目（ListWhitelistResponse 的尾部元素）
struct WhitelistEntry {
    u8      af
    u8      prefix_len
    addr16  addr
    str[16] device
}

# 白名单列表响应；必须分页。
#
# count / total / offset 三个字段的含义与 ListBansResponse 完全一致：只有
# count 时 daemon 无法判断「本页是否就是全部」（截断）也无法翻页——历史上
# 内核固定回第一页 + daemon 侧硬编码 64 条上限，导致白名单超过一页时整份
# 响应被丢弃。
message ListWhitelistResponse {
    type = MsgType::LIST_WHITELIST_RESPONSE
    u32             count    # 本页条目数
    u32             total    # 内核当前总条目数（供 daemon 感知截断）
    u32             offset   # 本页起始下标（IPv4 表序 + IPv6 表序）
    WhitelistEntry  tail
}

# 速率统计条目（ListRatesResponse 的尾部元素）
struct RateEntry {
    u8      af
    u8[3]   pad        # 显式填充，与内核侧布局一致
    u64     packets
    u64     bytes
    u64     syn_packets
    u64     udp_packets
    u64     icmp_packets
    u64     ack_packets
    u64     rst_packets
    u64     fin_packets
    addr16  addr
}

# 速率统计响应；必须分页。
#
# 历史实现无分页、无上限地一次返回全部条目（rate_count 上限默认 65535），
# 单条 84 字节 → payload 约 5.25 MB，导致：
#   - msg_len（u16）在 780 条以上回绕
#   - 以 GFP_ATOMIC 做数 MB 分配（可能失败，且原子上下文不允许）
# 分页是本次重写的强制项，见 gen.py 打印的容量余量。
message ListRatesResponse {
    type = MsgType::LIST_RATES_RESPONSE
    u32        count       # 本页条目数
    u32        total       # 内核当前总条目数（供 daemon 感知截断）
    u32        offset      # 本页起始下标（速率表序）
    u64        global_pps  # 全局平均包速率
    u64        global_bps  # 全局平均字节速率
    RateEntry  tail
}

# 分析数据子条目：UDP 端口分布
struct UdpPortItem {
    u16 port
    u64 packets
    u64 bytes
    u64 last_seen_secs
}

# 分析数据子条目：ICMP 类型分布
struct IcmpTypeItem {
    u8  type
    u8  code
    u64 packets
    u64 bytes
    u64 last_seen_secs
}

# 分析数据子条目：端口扫描者 / 服务探测者
struct ScannerItem {
    u8      af
    u8[3]   pad     # 显式填充
    addr16  addr
    u32     metric  # 端口扫描 = 唯一端口数；服务探测 = 协议种类数
    u64     packets
}

# 分析数据响应：一次打包包大小 / TTL / 分片 / UDP 端口 / ICMP 类型 /
# 扫描者 / 探测者，替代原先 7 个 procfs 文本接口。全定长（无变长尾部）。
message AnalysisResponse {
    type = MsgType::ANALYSIS_RESPONSE
    u64            pkt_sizes[5]            # 包大小分布桶
    u64            ttl_dist[6]             # TTL 分布桶
    u64            ip_frag_total
    u64            ip_frag_count
    u32            udp_port_count
    u32            udp_port_capacity
    UdpPortItem    udp_ports[64]
    u32            icmp_type_count
    u32            icmp_type_capacity
    IcmpTypeItem   icmp_types[64]
    u32            port_scan_count
    u32            port_scan_threshold
    ScannerItem    port_scanners[20]
    u32            service_probe_count
    u32            service_probe_threshold
    ScannerItem    service_probes[20]
}

# 单守护进程注册确认。
#
# 注册是**必须可观测**的：内核拒绝注册（已有活跃守护进程）时仍会回本消息并
# 置 accepted = 0，daemon 必须解析它并据此暴露「未取得内核唯一租约」的状态，
# 而不是把 sendto 成功当成注册成功——否则 daemon 会照常运行，而内核静默丢弃
# 它的全部指令（只留一条 pr_warn），表现为「控制全部无响应且无任何提示」。
# accepted = 0 时 daemon 必须重试或明确报错，不得继续以「已注册」自居。
message DaemonRegisterAck {
    type = MsgType::DAEMON_REGISTER_ACK
    u8 accepted   # 1 = 接受并完成注册；0 = 拒绝（已有活跃守护进程）
}

# ===========================================================================
# daemon → 内核
# ===========================================================================

# 封禁 IP。与 UnbanIp 共用同一载荷布局（内核按 sizeof(fw_nl_ban_cmd) 校验）
#
# prefix_len：网段封禁能力（集群扫描检测用）。语义与白名单的 prefix_len 一致却
# 不同形：封禁条目**不归一化主机位**（32/128 = 精确单机，即未加该字段前的行为），
# 匹配时按前缀比较。daemon 对网段封禁负责下发归一化后的网络地址。
message BanIp {
    type = MsgType::BAN_IP
    u8      af             # AddrFamily
    u8      prefix_len     # 前缀长度；32/128 = 精确单机
    u32     duration_secs  # 0 = 永久
    addr16  addr
    str[32] reason
}

# 解封 IP；duration_secs 与 reason 由发送方置 0
# prefix_len 需与封禁时一致，内核按 (af, addr, prefix_len) 定位条目。
message UnbanIp {
    type = MsgType::UNBAN_IP
    u8      af
    u8      prefix_len
    u32     duration_secs
    addr16  addr
    str[32] reason
}

# 配置下发
message SetConfig {
    type = MsgType::SET_CONFIG
    u32  flags                        # ConfigFlags
    u32  ban_time                     # 秒
    u32  rate_window_seconds          # 秒
    u64  max_packets_per_second
    u64  max_bytes_per_second
    u64  max_syn_per_second
    u64  max_udp_per_second
    u64  max_icmp_per_second
    u64  max_ack_per_second
    u64  max_rst_per_second
    u64  max_fin_per_second
    u32  dynamic_threshold_flags      # DynThresholdFlags
    u32  dynamic_threshold_ratio_x100
    u64  baseline_pps
    u64  baseline_bps
    u32  ddos_ban_duration            # 秒
}

# 受保护端口位图：daemon 定期扫描本机对外监听端口后下发。
#
# 语义是「纳入防护」而非「豁免」：置位端口 = 该端口的入站流量参与 DDoS 速率
# 判定。公网唯一能打到本机的地方就是这些对外监听端口，防护聚焦于此；未置位
# 端口不参与速率判定，避免内部流量产生误封。封禁表（由 jail 日志判定或手工
# 下发）不受本位图影响，仍对所有端口生效。
#
# 布局固定 8KB（65536 位，一端口一位），便于内核侧 RCU 整体换指针：
# 位 i 置位表示端口 i 受保护。
message SetProtectedPorts {
    type = MsgType::SET_PROTECTED_PORTS
    u32      count    # 置位端口数（观测用；内核不据此推导布局）
    u8[8192] bitmap   # 65536 位，位 i = 端口 i 受保护
}

# 封禁列表分页查询
message ListBansQuery {
    type = MsgType::LIST_BANS_QUERY
    u32 offset   # 起始下标
    u32 limit    # 本页上限；0 = 内核取默认页大小
}

# 白名单列表分页查询；分页参数语义与 ListBansQuery 完全一致。
# 历史上本消息无载荷（仅头），内核固定回第一页且 daemon 无法继续翻页。
message ListWhitelistQuery {
    type = MsgType::LIST_WHITELIST_QUERY
    u32 offset   # 起始下标
    u32 limit    # 本页上限；0 = 内核取默认页大小
}

# 速率统计分页查询；分页参数语义与 ListBansQuery 完全一致。
# 历史上本消息无载荷（仅头），内核固定回第一页；速率表容量远大于单页，
# 无 offset 意味着第二页起永远取不到（静默截断到单页）。
message ListRatesQuery {
    type = MsgType::LIST_RATES_QUERY
    u32 offset   # 起始下标
    u32 limit    # 本页上限；0 = 内核取默认页大小
}

# 添加白名单
message AddWhitelist {
    type = MsgType::ADD_WHITELIST
    u8      af
    u8      prefix_len
    addr16  addr
    str[16] device   # 空串表示不限定设备
}

# 移除白名单；载荷与 AddWhitelist 一致（内核按 sizeof(fw_nl_whitelist_cmd) 校验）
message RemoveWhitelist {
    type = MsgType::REMOVE_WHITELIST
    u8      af
    u8      prefix_len
    addr16  addr
    str[16] device
}

# ---------------------------------------------------------------------------
# 仅消息头（无载荷）
# ---------------------------------------------------------------------------
message StatsQuery           = MsgType::STATS_QUERY
message AnalysisQuery        = MsgType::ANALYSIS_QUERY
message DaemonRegister       = MsgType::DAEMON_REGISTER
