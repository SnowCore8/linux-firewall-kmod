[Unit]
Description=Firewall Daemon for IP Ban Protection
After=network.target systemd-modules-load.service

[Service]
Type=simple
User=root
Group=root
# 可选：把面板凭据从被 git 跟踪的 YAML 移到这台机器上的 0600 文件。
# 文件缺失时 systemd 仍会启动（前缀 `-`），凭据回落到 YAML。
EnvironmentFile=-/etc/firewall/credentials.env
ExecStart=/usr/local/sbin/firewall-daemon -C /etc/firewall 
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10

# Security Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/firewall /var/log
ReadOnlyPaths=/etc/firewall
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
# ProtectKernelModules=yes  # 注释：模块已通过 modules-load.d 在启动时加载
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Resource limits
LimitNOFILE=65536
LimitNPROC=10

[Install]
WantedBy=multi-user.target
