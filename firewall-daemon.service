[Unit]
Description=Firewall Daemon for IP Ban Protection
After=network.target systemd-modules-load.service

[Service]
Type=simple
User=root
Group=root
# 可选：把面板凭据从被 git 跟踪的 YAML 移到这台机器上的 0600 文件。
# 文件缺失时 systemd 仍会启动（前缀 `-`），凭据回落到 YAML。
EnvironmentFile=-/etc/firewall/credentials.env
ExecStart=__SBINDIR__/firewall-daemon -C /etc/firewall
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10

# Security Hardening
NoNewPrivileges=yes
ProtectSystem=strict
# ProtectSystem=strict 把整个文件系统挂成只读，systemd 需把下列每一项 bind-mount 回可写。
# 条目在启动时必须已存在，否则单元以 226/NAMESPACE 失败在 ExecStart 之前，
# 守护进程没有机会自行创建日志文件。/var/log/firewall.log 由包 postinst 预创建。
ReadWritePaths=/var/lib/firewall /var/log/firewall.log
ReadOnlyPaths=/etc/firewall
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
PrivateDevices=yes
# ProtectKernelModules=yes  # 注释：模块已通过 modules-load.d 在启动时加载
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077

# Resource limits
LimitNOFILE=65536
LimitNPROC=10

[Install]
WantedBy=multi-user.target
