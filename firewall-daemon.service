[Unit]
Description=Firewall Daemon for IP Ban Protection
After=network.target systemd-modules-load.service

[Service]
Type=forking
PIDFile=/run/firewall-daemon.pid
User=root
Group=root
ExecStart=/usr/local/sbin/firewall-daemon -c /etc/firewall --daemon
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10

# Security Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/firewall /var/log
ReadOnlyPaths=/etc/firewall
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
# ProtectKernelModules=yes  # 注释：模块已通过 modules-load.d 在启动时加载
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native

# Resource limits
LimitNOFILE=65536
LimitNPROC=10

[Install]
WantedBy=multi-user.target
