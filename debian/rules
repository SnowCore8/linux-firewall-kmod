#!/usr/bin/make -f
# debian/rules - debhelper 驱动。build-deb.sh 只负责生成 debian/changelog 与搬运产物。

VERSION := $(shell dpkg-parsechangelog -S Version)
PKGDIR  := $(CURDIR)/debian/linux-firewall-kmod

%:
	dh $@

# 内核模块由目标机的 DKMS 编译，本地只编守护进程（含前端）。
override_dh_auto_build:
	$(MAKE) contract
	$(MAKE) daemon

# 上游 test 目标要 root，且会编译并加载 .ko；打包时不跑。
override_dh_auto_test:
	@echo "Skipping upstream 'make test' (integration tests need root and a loaded kernel module)"

override_dh_auto_install:
	$(MAKE) install-daemon install-config install-state install-systemd \
	    DESTDIR=$(PKGDIR) PREFIX=/usr SYSTEMDDIR=/lib/systemd/system

	# DKMS 源码树：dkms.conf 的 PACKAGE_VERSION 占位符在构建期替换
	install -d $(PKGDIR)/usr/src/linux-firewall-kmod-$(VERSION)/src/kernel-module
	cp -r src/kernel-module/* $(PKGDIR)/usr/src/linux-firewall-kmod-$(VERSION)/src/kernel-module/
	install -d $(PKGDIR)/usr/src/linux-firewall-kmod-$(VERSION)/contract/generated
	cp contract/generated/*.h $(PKGDIR)/usr/src/linux-firewall-kmod-$(VERSION)/contract/generated/
	install -m 644 Makefile.dkms dkms.conf $(PKGDIR)/usr/src/linux-firewall-kmod-$(VERSION)/
	sed -i 's|#MODULE_VERSION#|$(VERSION)|g' \
	    $(PKGDIR)/usr/src/linux-firewall-kmod-$(VERSION)/dkms.conf

# dh_fixperms 默认把 0600/0700 放宽成 0644/0755；配置与状态目录保持安装目标的权限。
override_dh_fixperms:
	dh_fixperms
	chmod 0700 $(PKGDIR)/etc/firewall
	chmod 0600 $(PKGDIR)/etc/firewall/*.yaml
	chmod 0700 $(PKGDIR)/var/lib/firewall

# dh_auto_clean 默认跑上游 make clean，会连带重建前端；设为空操作保留增量构建。
# 序列末尾的 dh_clean 仍会清掉 debian/<pkg> 等暂存物。
override_dh_auto_clean:
	@echo "Skipping upstream 'make clean' to keep incremental daemon/frontend builds"
