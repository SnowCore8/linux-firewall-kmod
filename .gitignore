# ============================================================
# Firewall 项目 .gitignore
# ============================================================

# ---- 构建产物 ----
build/
target/
site/
docs/_book/
docs/node_modules/

# 前端构建产物（vite 输出到 rust-embed 嵌入目录）
# 整个目录内容都是生成物（index.html / app.js / style.css / sw.js /
# manifest.webmanifest / icons/），统一忽略；目录本身由构建过程创建
# （vite 的 emptyOutDir 或 CI 里的 mkdir -p），因此不放入库占位文件。
src/daemon/web_ui/static/*

# 内核模块编译产物（in-tree 构建时产生，Makefile 会在构建后清理但需防御性忽略）
*.ko
*.o
*.mod.c
*.mod
*.mod.o
Module.symvers
modules.order

# Go 模块清单会被上面的内核构建规则 *.mod 误伤，此处显式放行
!go.mod

# 内核构建系统产生的隐藏文件（以 . 开头的中间文件）
.*.cmd
.*.o
.*.d

# 内核构建临时目录
.tmp_versions/

# ---- 临时文件 ----
*~
*.tmp
*.bak
*.orig
*.rej
*.patch

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
.clangd/
compile_commands.json
*.cache

# ---- 测试临时文件 ----
tests/*.ko
tests/*.log
tests/reports/
/tmp/fw_*

# Python 字节码缓存（跑 pytest 时产生）
__pycache__/
*.py[cod]

# ---- OS 特定文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 打包 / 归档 ----
*.tar.gz
*.zip
*.deb
*.rpm

# ---- AI 工具 ----
.qwen/
!.qwen/skills/
.cursor/
.cursorrules
.claude/
.agents/
agents/
AGENTS.md
opencode.json
.opencode/

# ---- 安全 ----
*.key
*.pem
.env

# ---- Node.js / Playwright E2E ----
node_modules/
# 仅忽略根目录锁文件；frontend/package-lock.json 必须入库（CI 用 npm ci 保证可复现）
/package-lock.json
test-results/
playwright-report/
blob-report/
# Playwright MCP 的默认输出目录（快照/截图/console 日志落在进程 cwd）
.playwright-mcp/
config/debug-*.yaml
# daemon 的运行期覆盖文件（目录模式下每次回写都重新生成，内容随运行状态变化）
config/_overrides.yaml

# ---- 性能基线工具构建物 ----
# scripts/bench/ 的源码与脚本入库；编译产物不入库（make -C scripts/bench 生成）
scripts/bench/blast2
scripts/bench/sink
