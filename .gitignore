# ============================================================
# Firewall 项目 .gitignore
# ============================================================

# ---- 构建产物 ----
build/
site/

# 内核模块编译产物（in-tree 构建时产生，Makefile 会在构建后清理但需防御性忽略）
*.ko
*.o
*.mod.c
*.mod
*.mod.o
Module.symvers
modules.order

# 内核构建系统产生的隐藏文件（以 . 开头的中间文件）
.*.cmd
.*.o
.*.d

# 内核构建临时目录
.tmp_versions/

# ---- 临时文件 ----
*~
*.tmp
*.bak
*.orig
*.rej
*.patch

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
.clangd/
compile_commands.json
*.cache

# ---- 测试临时文件 ----
tests/*.ko
tests/*.log
tests/reports/
/tmp/fw_*

# ---- OS 特定文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 打包 / 归档 ----
*.tar.gz
*.zip
*.deb
*.rpm

# ---- AI 工具 ----
.qwen/
.cursor/
.cursorrules
.claude/
agents/
AGENTS.md
opencode.json

# ---- 安全 ----
*.key
*.pem
.env
