# ============================================================
# Firewall 项目 .gitignore
# ============================================================

# ---- 构建产物 ----
build/
site/
*.ko
*.ko.cmd
*.mod.c
*.mod
*.o
Module.symvers
modules.order

# ---- 临时文件 ----
*~
*.tmp
*.bak
*.orig
*.rej
*.patch

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
.clangd/
compile_commands.json
*.cache

# ---- 测试临时文件 ----
tests/*.ko
tests/*.log
tests/reports/
/tmp/fw_*

# ---- OS 特定文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 打包 / 归档 ----
*.tar.gz
*.zip
*.deb
*.rpm

# ---- AI 工具 ----
.qwen/
.cursor/
.cursorrules
.claude/

# ---- 安全 ----
*.key
*.pem
.env
