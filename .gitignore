# ============================================================
# Firewall 项目 .gitignore
# ============================================================

# ---- 构建产物 ----
# out-of-tree 构建目录
build/
# 内核模块编译产物
*.o
*.ko
*.mod.c
*.mod.o
.*.cmd
modules.order
Module.symvers
*.mod
.module-common.o
# 守护进程编译产物
firewall-daemon
firewall-ko-daemon

# ---- 临时文件 ----
*~
*.tmp
*.bak
*.orig
*.rej
*.patch

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
.clangd/
compile_commands.json
*.cache

# ---- 日志文件 ----
*.log

# ---- 测试临时文件 ----
tests/*.ko
tests/*.log

# ---- 运行时生成 ----
/var/lib/firewall/state

# ---- 打包 / 归档 ----
*.tar.gz
*.zip
*.deb
*.rpm

# ---- OS 特定文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- AI 工具 ----
.qwen/
bans.db
