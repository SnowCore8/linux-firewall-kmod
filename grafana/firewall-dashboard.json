{
  "dashboard": {
    "id": null,
    "uid": "firewall-daemon",
    "title": "Firewall Daemon Dashboard",
    "tags": ["firewall", "security"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "type": "row",
        "title": "日志解析",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
      },
      {
        "type": "stat",
        "title": "已解析日志行",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
        "targets": [
          {
            "expr": "firewall_lines_parsed_total",
            "legendFormat": "Lines Parsed"
          }
        ]
      },
      {
        "type": "stat",
        "title": "跳过行数",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
        "targets": [
          {
            "expr": "firewall_lines_skipped_total",
            "legendFormat": "Skipped"
          }
        ]
      },
      {
        "type": "stat",
        "title": "日志轮转次数",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
        "targets": [
          {
            "expr": "firewall_log_rotations_total",
            "legendFormat": "Rotations"
          }
        ]
      },
      {
        "type": "stat",
        "title": "inotify 唤醒次数",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
        "targets": [
          {
            "expr": "firewall_inotify_events_total",
            "legendFormat": "Inotify Wakes"
          }
        ]
      },
      {
        "type": "graph",
        "title": "日志解析速率",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
        "targets": [
          {
            "expr": "rate(firewall_lines_parsed_total[5m])",
            "legendFormat": "Lines/sec"
          }
        ]
      },
      {
        "type": "graph",
        "title": "正则命中速率",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
        "targets": [
          {
            "expr": "rate(firewall_regex_matches_total[5m])",
            "legendFormat": "Matches/sec"
          }
        ]
      },
      {
        "type": "row",
        "title": "封禁与 DDoS",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 13}
      },
      {
        "type": "graph",
        "title": "封禁触发速率",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
        "targets": [
          {
            "expr": "rate(firewall_bans_triggered_total[5m])",
            "legendFormat": "Bans/sec"
          }
        ]
      },
      {
        "type": "graph",
        "title": "DDoS 事件速率",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
        "targets": [
          {
            "expr": "rate(firewall_ddos_events_total[5m])",
            "legendFormat": "Events/sec"
          }
        ]
      },
      {
        "type": "row",
        "title": "内核链路（netlink）",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22}
      },
      {
        "type": "graph",
        "title": "netlink 报文速率",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
        "targets": [
          {
            "expr": "rate(firewall_netlink_messages_sent_total[5m])",
            "legendFormat": "发送/sec"
          },
          {
            "expr": "rate(firewall_netlink_messages_received_total[5m])",
            "legendFormat": "接收/sec"
          }
        ]
      },
      {
        "type": "graph",
        "title": "netlink 错误速率",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
        "targets": [
          {
            "expr": "rate(firewall_netlink_send_errors_total[5m])",
            "legendFormat": "发送错误/sec"
          },
          {
            "expr": "rate(firewall_netlink_recv_errors_total[5m])",
            "legendFormat": "接收错误/sec"
          }
        ]
      },
      {
        "type": "stat",
        "title": "内核拒绝指令数",
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 31},
        "targets": [
          {
            "expr": "firewall_kernel_commands_rejected_total",
            "legendFormat": "Rejected"
          }
        ]
      },
      {
        "type": "row",
        "title": "运维",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 35}
      },
      {
        "type": "stat",
        "title": "配置热重载次数",
        "gridPos": {"h": 4, "w": 12, "x": 0, "y": 36},
        "targets": [
          {
            "expr": "firewall_daemon_config_reloads_total",
            "legendFormat": "Reloads"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
