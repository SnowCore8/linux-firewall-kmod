{
  "dashboard": {
    "id": null,
    "uid": "firewall-daemon",
    "title": "Firewall Daemon Dashboard",
    "tags": ["firewall", "security"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "type": "stat",
        "title": "Uptime",
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "firewall_daemon_uptime_seconds",
            "legendFormat": "Uptime"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "type": "stat",
        "title": "Active Bans",
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
        "targets": [
          {
            "expr": "firewall_active_ban_count",
            "legendFormat": "Active Bans"
          }
        ]
      },
      {
        "type": "stat",
        "title": "Kernel Banned IPs",
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "firewall_kernel_banned_ips_current",
            "legendFormat": "Kernel Bans"
          }
        ]
      },
      {
        "type": "stat",
        "title": "SQLite WAL Size",
        "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
        "targets": [
          {
            "expr": "firewall_sqlite_wal_size_bytes",
            "legendFormat": "WAL Size"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "type": "graph",
        "title": "Lines Parsed Rate",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "targets": [
          {
            "expr": "rate(firewall_daemon_lines_parsed_total[5m])",
            "legendFormat": "Lines/sec"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Bans Triggered Rate",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "targets": [
          {
            "expr": "rate(firewall_daemon_ips_banned_total[5m])",
            "legendFormat": "Bans/sec"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Failed Attempts Rate",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
        "targets": [
          {
            "expr": "rate(firewall_daemon_failed_attempts_total[5m])",
            "legendFormat": "Failed/sec"
          }
        ]
      },
      {
        "type": "graph",
        "title": "Per-Jail Bans Triggered",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
        "targets": [
          {
            "expr": "rate(firewall_jail_bans_triggered_total[5m])",
            "legendFormat": "{{jail}}"
          }
        ]
      },
      {
        "type": "table",
        "title": "Per-Jail Statistics",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "firewall_jail_lines_parsed_total",
            "legendFormat": "{{jail}} - Lines Parsed",
            "format": "table",
            "instant": true
          },
          {
            "expr": "firewall_jail_bans_triggered_total",
            "legendFormat": "{{jail}} - Bans",
            "format": "table",
            "instant": true
          },
          {
            "expr": "firewall_jail_failed_attempts_total",
            "legendFormat": "{{jail}} - Failed",
            "format": "table",
            "instant": true
          },
          {
            "expr": "firewall_jail_active_bans",
            "legendFormat": "{{jail}} - Active Bans",
            "format": "table",
            "instant": true
          }
        ]
      },
      {
        "type": "row",
        "title": "DDoS Protection",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 28}
      },
      {
        "type": "graph",
        "title": "DDoS Events Timeline",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
        "targets": [
          {
            "expr": "rate(firewall_ddos_events_total[5m])",
            "legendFormat": "Events/sec"
          },
          {
            "expr": "rate(firewall_ddos_auto_bans_total[5m])",
            "legendFormat": "Auto Bans/sec"
          }
        ]
      },
      {
        "type": "stat",
        "title": "DDoS Tracked IPs",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
        "targets": [
          {
            "expr": "firewall_ddos_tracked_ips",
            "legendFormat": "Tracked IPs"
          }
        ]
      },
      {
        "type": "row",
        "title": "Kernel Module",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 37}
      },
      {
        "type": "graph",
        "title": "Kernel Ban/Unban Operations",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 38},
        "targets": [
          {
            "expr": "rate(firewall_kernel_bans_total[5m])",
            "legendFormat": "Bans/sec"
          },
          {
            "expr": "rate(firewall_kernel_unbans_total[5m])",
            "legendFormat": "Unbans/sec"
          }
        ]
      },
      {
        "type": "stat",
        "title": "Kernel Whitelist Count",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 38},
        "targets": [
          {
            "expr": "firewall_kernel_whitelist_count",
            "legendFormat": "Whitelist IPs"
          }
        ]
      },
      {
        "type": "row",
        "title": "Operations",
        "gridPos": {"h": 1, "w": 24, "x": 0, "y": 46}
      },
      {
        "type": "stat",
        "title": "Config Reloads",
        "gridPos": {"h": 4, "w": 8, "x": 0, "y": 47},
        "targets": [
          {
            "expr": "firewall_daemon_config_reloads_total",
            "legendFormat": "Reloads"
          }
        ]
      },
      {
        "type": "stat",
        "title": "Log Rotations",
        "gridPos": {"h": 4, "w": 8, "x": 8, "y": 47},
        "targets": [
          {
            "expr": "firewall_daemon_log_rotations_total",
            "legendFormat": "Rotations"
          }
        ]
      },
      {
        "type": "stat",
        "title": "Lines Skipped",
        "gridPos": {"h": 4, "w": 8, "x": 16, "y": 47},
        "targets": [
          {
            "expr": "firewall_daemon_lines_skipped_total",
            "legendFormat": "Skipped"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
